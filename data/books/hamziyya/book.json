{"id":"hamziyya","type":"qasida","title":"أم القرى في مدح خير الورى","shortTitle":"الهمزية","subtitle":"«القصيدة الهمزية»","author":"الإمام أبو عبد الله محمد بن سعيد بن حمّاد البوصيري","meter":"قصيدة همزيّة على بحر الخفيف","chapters":[{"title":"سمو المقام النبوي","from":1},{"title":"نسبه وميلاده","from":6},{"title":"رضاعه وعجائبه","from":28},{"title":"نشأته في حال طفولته وما بعدها","from":44},{"title":"حجب الشياطين عند دنوّ البعثة","from":46},{"title":"الجدّ في نشر الدعوة","from":57},{"title":"الهجرة","from":65},{"title":"الإسراء والمعراج","from":73},{"title":"التبليغ والدعاء إلى الله","from":78},{"title":"كفاية الله تعالى له","from":86},{"title":"نقض الصحيفة","from":95},{"title":"عناية الله تعالى بنبيه صلى الله عليه وآله وسلم","from":102},{"title":"من أخلاقه صلى الله عليه وآله وسلم ومحاسن صفاته","from":117},{"title":"من معجزاته","from":143},{"title":"تمني الناظم رؤيته ولقاءه صلى الله عليه وآله وسلم","from":153},{"title":"القرآن","from":183},{"title":"ما آل إليه أمر أهل الكتابين","from":199},{"title":"اتصاف اليهود بأوصاف ذميمة وما نالهم من جراء خداعهم","from":244},{"title":"مجازاة المؤذين بالهلاك","from":258},{"title":"عاقبة قومه المناوين له","from":266},{"title":"عفوه وجمال أفعاله","from":272},{"title":"الحج والزيارة","from":282},{"title":"التنقل بين مكة وبقية المشاعر","from":297},{"title":"السَّيْر للزيارة المشرفة","from":303},{"title":"ما يعتري القادمين من عظيم المهابة","from":313},{"title":"المواجهة الشريفة","from":320},{"title":"استعطافه صلى الله عليه وآله وسلم","from":326},{"title":"الإقسام على النبي صلى الله عليه وآله وسلم بآله","from":331},{"title":"الإقسام بالصحابة الكرام","from":346},{"title":"طلب الأمان للحصول على النجاة","from":380},{"title":"الضراعة وإظهار التحسر","from":421},{"title":"باعث مدحه","from":428},{"title":"العجز عن مدحه صلى الله عليه وآله وسلم","from":444},{"title":"التسليم على خير البرية","from":450}],"verses":[{"n":1,"s":["كَيْفَ تَرْقَى رُقِيَّكَ الأَنْبِيَاءُ","يَا سَمَاءً مَا طَاوَلَتْهَا سَمَاءُ"]},{"n":2,"s":["لَمْ يُسَاوُوكَ فِي عُلَاكَ وَقَدْ حَا","لَ سَنًى مِنْكَ دُونَهُمْ وَسَنَاءُ"]},{"n":3,"s":["إِنَّمَا مَثَّلُوا صِفَاتِكَ لِلنَّا","سِ كَمَا مَثَّلَ النُّجُومَ الْمَاءُ"]},{"n":4,"s":["أَنْتَ مِصْبَاحُ كُلِّ فَضْلٍ فَمَا تَصْ","دُرُ إِلَّا عَنْ ضَوْئِكَ الْأَضْوَاءُ"]},{"n":5,"s":["لَكَ ذَاتُ الْعُلُومِ مِنْ عَالِمِ الْغَيْ","بِ وَمِنْهَا لآدَمَ الأَسْمَاءُ"]},{"n":6,"s":["لَمْ تَزَلْ فِي ضَمَائِرِ الْكَوْنِ تُخْتَا","رُ لَكَ الأُمَّهَاتُ وَالآبَاءُ"]},{"n":7,"s":["مَا مَضَتْ فَتْرَةٌ مِنَ الرُّسْلِ إِلَّا","بَشَّرَتْ قَوْمَهَا بِكَ الْأَنْبِيَاءُ"]},{"n":8,"s":["تَتَبَاهَى بِكَ الْعُصُورُ وَتَسْمُو","بِكَ عَلْيَاءُ بَعْدَهَا عَلْيَاءُ"]},{"n":9,"s":["وَبَدَا لِلْوُجُودِ مِنكَ كَرِيمٌ","مِنْ كَرِيمٍ آبَاؤُهُ كُرَمَاءُ"]},{"n":10,"s":["نَسَبٌ تَحْسِبُ الْعُلَا بِحُلَاهُ","قَلَّدَتْهَا نُجُومَهَا الْجَوْزَاءُ"]},{"n":11,"s":["حَبَّذَا عِقْدُ سُؤْدَدٍ وَفَخَارٍ","أَنْتَ فِيهِ الْيَتِيمَةُ الْعَصْمَاءُ"]},{"n":12,"s":["وَمُحَيّاً كَالشَّمْسِ مِنْكَ مُضِيءٌ","أَسْفَرَتْ عَنْهُ لَيْلَةٌ غَرَّاءُ"]},{"n":13,"s":["لَيْلَةُ الْمَوْلِدِ الذِي كَانَ لِلدِّي","نِ سُرُورٌ بِيَوْمِهِ وَازْدِهَاءُ"]},{"n":14,"s":["وَتَوَالَتْ بُشْرَى الْهَوَاتِفِ أَنْ قَدْ","وُلِدَ الْمُصْطَفَى وَحَقَّ الْهَنَاءُ"]},{"n":15,"s":["وَتَدَاعَى إِيوَانُ كِسْرَى وَلَولاَ","آيَةٌ مِنْكَ مَا تَدَاعَى الْبِنَاءُ"]},{"n":16,"s":["وَغَدَا كُلُّ بَيْتِ نَارٍ وَفِيهِ","كُرْبَةٌ مِنْ خُمُودِهَا وَبَلاَءُ"]},{"n":17,"s":["وَعُيُونٌ لِلْفُرْسِ غَارَتْ فَهَلْ كَا","نَ لِنِيرَانِهِمْ بِهَا إِطْفَاءُ"]},{"n":18,"s":["مَوْلِدٌ كَانَ مِنْهُ فِي طَالِعِ الْكُفْ","رِ وَبَالٌ عَلَيْهِمُ وَوَبَاءُ"]},{"n":19,"s":["فَهَنِيئاً بِهِ لآمِنَةَ الْفَضْ","لُ الذِي شُرِّفَتْ بِهِ حَوَّاءُ"]},{"n":20,"s":["مَنْ لِحَوَّاءَ أَنَّهَا حَمَلَتْ أَحْ","مَدَ أَوْ أَنَّهَا بِهِ نُفَسَاءُ"]},{"n":21,"s":["يَوْمَ نَالَتْ بِوَضْعِهِ ابْنَةُ وَهْبٍ","مِنْ فَخَارٍ مَا لَمْ تَنَلْهُ النِّسَاءُ"]},{"n":22,"s":["وَأَتَتْ قَوْمَهَا بِأَفْضَلَ مِمَّا","حَمَلَتْ قَبْلُ مَرْيَمُ الْعَذْرَاءُ"]},{"n":23,"s":["شَمَّتَتْهُ الأَمْلاَكُ إِذْ وَضَعَتْهُ","وَشَفَتْنَا بِقَولِهَا الشَّفَّاءُ"]},{"n":24,"s":["رَافِعًا رَأْسَهُ وَفِي ذَلِكَ الرَّفْ","عِ إِلَى كُلِّ سُؤْدَدٍ إِيمَاءُ"]},{"n":25,"s":["رَامِقًا طَرْفُهُ السَّمَاءَ وَمَرْمَى","عَيْنِ مَنْ شَأْنُهُ الْعُلُوُّ الْعَلاَءُ"]},{"n":26,"s":["وَتَدَلَّتْ زُهْرُ النُّجُومِ إِلَيْهِ","فَأَضَاءَتْ بِضَوْئِهَا الْأَرْجَاءُ"]},{"n":27,"s":["وَتَرَاءَتْ قُصُورُ قَيْصَرَ بالرُّو","مِ يَرَاهَا مَنْ دَارُهُ الْبَطْحَاءُ"]},{"n":28,"s":["وَبَدَتْ فِي رَضَاعِهِ مُعْجِزَاتٌ","لَيْسَ فِيهَا عَنِ الْعُيُونِ خَفَاءُ"]},{"n":29,"s":["إِذْ أَبَتْهُ لِيُتْمِهِ مُرْضِعَاتٌ","قُلْنَ مَا فِي الْيَتِيمِ عَنَّا غَنَاءُ"]},{"n":30,"s":["فَأَتَتْهُ مِنْ آلِ سَعْدٍ فَتَاةٌ","قَدْ أَبَتْهَا لِفَقْرِهَا الرُّضَعَاءُ"]},{"n":31,"s":["أَرْضَعَتْهُ لِبَانَهَا فَسَقَتْهَا","وَبَنِيهَا أَلْبَانَهُنَّ الشَّاءُ"]},{"n":32,"s":["أَصْبَحَتْ شُوَّلًا عِجَافًا وَأَمْسَتْ","مَا بِهَا شَائِلٌ وَلاَ عَجْفَاءُ"]},{"n":33,"s":["أَخْصَبَ الْعَيْشُ عِنْدَهَا بَعْدَ مَحْلٍ","إِذْ غَدَا لِلنَّبِيِّ مِنْهَا غِذَاءُ"]},{"n":34,"s":["يَا لَهَا مِنَّةٌ لَقَدْ ضُوعِفَ الأَجْ","رُ عَلَيْهَا مِنْ جِنْسِهَا وَالْجَزَاءُ"]},{"n":35,"s":["وَإِذَا سَخَّرَ الإِلَهُ أُنَاساً","لِسَعِيدٍ فَإِنَّهُمْ سُعَدَاءُ"]},{"n":36,"s":["حَبَّةٌ أَنْبَتَتْ سَنَابِلَ وَالْعَصْ","فُ لَدَيْهِ يَسْتَشْرِفُ الضُّعَفَاءُ"]},{"n":37,"s":["وَأَتَتْ جَدَّهُ وَقَدْ فَصَلَتْهُ","وَبِهَا مِنْ فِصَالِهِ الْبُرَحَاءُ"]},{"n":38,"s":["إِذْ أَحَاطَتْ بِهِ مَلاَئِكَةُ الل","هِ فَظَنَّتْ بِأَنَّهُمْ قُرَنَاءُ"]},{"n":39,"s":["وَرَأَى وَجْدَهَا بِهِ وَمِنَ الْوَجْ","دِ لَهِيبٌ تَصْلَى بِهِ الْأَحْشَاءُ"]},{"n":40,"s":["فَارَقَتْهُ كَرْهاً وَكَانَ لَدَيْهَا","ثَاوِياً لاَ يُمَلُّ مِنْهُ الثَّوَاءُ"]},{"n":41,"s":["شُقَّ عَنْ قَلْبِهِ وَأُخْرِجَ مِنْهُ","مُضْغَةٌ عِنْدَ غَسْلِهِ سَوْدَاءُ"]},{"n":42,"s":["خَتَمَتْهُ يُمْنَى الأَمِينِ وَقَدْ أُو","دِعَ مَا لَمْ تُذَعْ لَهُ أَنْبَاءُ"]},{"n":43,"s":["صَانَ أَسْرَارَهُ الْخِتَامُ فَلاَ الْفَ","ضُّ مُلِمٌّ بِهِ وَلاَ الإِفْضَاءُ"]},{"n":44,"s":["أَلِفَ النُّسْكَ وَالْعِبَادَةَ وَالْخَلْ","وَةَ طِفْلاً وَهَكَذَا النُّجَبَاءُ"]},{"n":45,"s":["وَإِذَا حَلَّتِ الْهِدَايَةُ قَلْباً","نَشِطَتْ لِلْعِبَادَةِ الأَعْضَاءُ"]},{"n":46,"s":["بَعَثَ اللهُ عِنْدَ مَبْعَثِهِ الشُّهْ","بَ حِرَاسًا وَضَاقَ عَنْهَا الْفَضَاءُ"]},{"n":47,"s":["تَطْرُدُ الْجِنَّ عَنْ مَقَاعِدَ لِلسَّمْ","عِ كَمَا تَطْرُدُ الذِّئَابَ الرِّعَاءُ"]},{"n":48,"s":["فَمَحَتْ آيَةَ الْكَهَانَةِ آيَا","تٌ مِنَ الْوَحْيِ مَا لَهُنَّ امِّحَاءُ"]},{"n":49,"s":["وَرَأَتْهُ خَدِيجَةٌ وَالتُّقَى وَال","زُّهْدُ فِيهِ سَجِيَّةٌ وَالْحَيَاءُ"]},{"n":50,"s":["وَأَتَاهَا أَنَّ الْغَمَامَةَ وَالسَّرْ","حَ أَظَلَّتْهُ مِنْهُمَا أَفْيَاءُ"]},{"n":51,"s":["وَأَحَادِيثُ أَنَّ وَعْدَ رَسُولِ","اللهِ بِالْبَعْثِ حَانَ مِنْهُ الْوَفَاءُ"]},{"n":52,"s":["فَدَعَتْهُ إِلَى الزَّوَاجِ وَمَا أَحْ","سَنَ مَا يَبْلُغُ الْمُنَى الأَذْكِيَاءُ"]},{"n":53,"s":["وَأَتَاهُ فِي بَيْتِهَا جَبْرَئِيلُ","وَلِذِي اللُّبِّ فِي الأُمُورِ ارْتِيَاءُ"]},{"n":54,"s":["فَأَمَاطَتْ عَنْهَا الْخِمَارَ لِتَدْرِي","أَهُوَ الْوَحْيُ؟ أَمْ هُوَ الإِغْمَاءُ"]},{"n":55,"s":["فَاخْتَفَى عِنْدَ كَشْفِهَا الرَّأْسَ جِبْرِي","لُ فَمَا عَادَ أَوْ أُعِيدَ الغِطَاءُ"]},{"n":56,"s":["فَاسْتَبَانَتْ خَدِيجَةٌ أَنَّهُ الْكَنْ","زُ الَّذِي حَاوَلَتْهُ وَالكِيمْيَاءُ"]},{"n":57,"s":["ثُمَّ قَامَ النَّبِيُّ يَدْعُو إِلَى اللَّه","وَفِي الْكُفْرِ نَجْدةٌ وَإِبَاءُ"]},{"n":58,"s":["أُمَماً أُشْرِبَتْ قُلُوبُهُمُ الْكُفْ","رَ فَدَاءُ الضَّلَالِ فِيهِمْ عَيَاءُ"]},{"n":59,"s":["وَرَأَيْنَا آيَاتِهِ فَاهْتَديْنَا","وَإِذَا الْحَقُّ جَاءَ زَالَ الْمِرَاءُ"]},{"n":60,"s":["رَبِّ إِنَّ الْهُدَى هُدَاكَ وَآيَا","تُكَ نُورٌ تَهْدِي بِهَا مَنْ تَشَاءُ"]},{"n":61,"s":["كَمْ رَأَيْنَا مَا لَيْسَ يَعْقِلُ قَدْ أُلْ","هِمَ مَا لَيْسَ يُلْهَمُ الْعُقَلاَءُ"]},{"n":62,"s":["إِذْ أَبَى الْفِيلُ مَا أَتَى صَاحِبُ الْفِي","لِ وَلَمْ يَنْفَعِ الْحِجَا وَالذَّكَاءُ"]},{"n":63,"s":["والْجَمَادَاتُ أَفْصَحَتْ بِالذِي أُخْ","رِسَ عَنْهُ لِأَحْمَدَ الْفُصَحَاءُ"]},{"n":64,"s":["وَيْحَ قَوْمٍ جَفَوْا نَبِيّاً بِأَرْضٍ","أَلِفَتْهُ ضِبَابُهَا وَالظِّبَاءُ"]},{"n":65,"s":["وَسَلَوْهُ وَحَنَّ جِذْعٌ إِلَيْهِ","وَقَلَوْهُ وَوَدَّهُ الْغُرَباءُ"]},{"n":66,"s":["أخْرَجُوهُ مِنْهَا وَآوَاهُ غَارٌ","وَحَمَتْهُ حَمَامَةٌ وَرْقَاءُ"]},{"n":67,"s":["وَكَفَتْهُ بِنَسْجِهَا عَنْكَبُوتٌ","مَا كَفَتْهُ الْحَمَامَةُ الْحَصْدَاءُ"]},{"n":68,"s":["وَاخْتَفَى مِنْهُمُ عَلَى قُرْبِ مَرآ","هُ وَمِنْ شِدَّةِ الظُّهُورِ الْخَفَاءُ"]},{"n":69,"s":["وَنَحَا الْمُصْطَفَى الْمَدِينَةَ وَاشْتَا","قَتْ إِلَيْهِ مِنْ مَكَّةَ الأَنْحَاءُ"]},{"n":70,"s":["وَتَغَنَّتْ بِمَدْحِهِ الْجِنُّ حَتَّى","أَطْرَبَ الإِنْسَ مِنْهُ ذَاكَ الْغِنَاءُ"]},{"n":71,"s":["واقْتَفَى إِثْرَهُ سُرَاقَةُ فَاسْتَهْ","وَتْهُ فِي الأَرْضِ صَافِنٌ جَرْدَاءُ"]},{"n":72,"s":["ثُمَّ نَادَاهُ بَعْدَمَا سِيمَتِ الْخَسْ","فَ وَقَدْ يُنْجِدُ الْغَرِيقَ النِّدَاءُ"]},{"n":73,"s":["فَطَوَى الأَرْضَ سَائِراً والسَّمَوَا","تُ العُلاَ فَوْقَهَا لَهُ إِسْرَاءُ"]},{"n":74,"s":["فَصِفِ اللَّيْلَةَ التِي كَانَ لِلْمُخْ","تَارِ فِيهَا عَلَى البُرَاقِ اسْتِوَاءُ"]},{"n":75,"s":["وَتَرَقَّى بِهِ إِلَى قَابِ قَوْسَيْ","نِ وَتِلْكَ السِّيَّادَةُ الْقَعْسَاءُ"]},{"n":76,"s":["رُتَبٌ تَسْقُطُ الأَمَانِيُّ حَسْرَى","دُونَهَا مَا وَرَاءَهُنَّ وَرَاءُ"]},{"n":77,"s":["ثُمَّ وَافَى يُحَدِّثُ النَّاسَ شُكْراً","إِذْ أَتَتْهُ مِنْ رَبّهِ النَّعْمَاءُ"]},{"n":78,"s":["وَتَحَدَّى فَارْتَابَ كُلُّ مُرِيبٍ","أَوَ يَبْقَى مَعَ السُّيُولِ الْغُثَاءُ"]},{"n":79,"s":["وَهْوَ يَدْعُو إلى الإِلَهِ وَإنْ شَ","قَّ عَلَيْهِ كُفْرٌ بِهِ وَازْدِرَاءُ"]},{"n":80,"s":["وَيَدُلُّ الْوَرَى عَلَى اللهِ بِالتّوْ","حِيدِ وَهْوَ الْمَحَجَّةُ الْبَيْضَاءُ"]},{"n":81,"s":["فَبِمَا رَحْمَةٍ مِنَ الله لَانَتْ","صَخْرَةٌ مِنْ إِبَائِهِمْ صَمَّاءُ"]},{"n":82,"s":["وَاسْتَجَابَتْ لَهُ بِنَصْرٍ وَفَتْحٍ","بَعْدَ ذَاكَ الْخَضْرَاءُ وَالْغَبْرَاءُ"]},{"n":83,"s":["وَأَطَاعَتْ لأَمْرِهِ الْعَرَبُ الْعَرْ","بَاءُ والْجَاهِلِيَّةُ الجَهْلاَءُ"]},{"n":84,"s":["وَتَوَالَتْ لِلْمُصْطَفَى الآيَةُ الْكُبْ","رَى عَلَيْهِمْ وَالْغَارَةُ الشَّعْوَاءُ"]},{"n":85,"s":["وَإِذَا مَا تَلاَ كِتَاباً مِنَ الله","تَلَتْهُ كَتِيبَةٌ خَضْرَاءُ"]},{"n":86,"s":["وَكَفَاهُ الْمُسْتَهْزِئِينَ وَكَمْ سَا","ءَ نَبِيّاً مِنْ قَوْمِهِ اسْتِهْزَاءُ"]},{"n":87,"s":["وَرَمَاهُمْ بِدَعْوَةٍ مِنْ فِنَاءِ","الْبَيْتِ فِيهَا لِلظَّالِمِينَ فَنَاءُ"]},{"n":88,"s":["خَمْسَةٌ كُلُّهُمْ أُصِيبُوا بِدَاءٍ","والرَّدَى مِنْ جُنُودِهِ الأَدْوَاءُ"]},{"n":89,"s":["فَدَهَى الأَسْوَدَ بْنَ مُطَّلِبٍ أَيُّ","عَمىً مَيِّتٌ بِهِ الأَحْيَاءُ"]},{"n":90,"s":["وَدَهَى الأَسْوَدَ بْنَ عَبْدِ يَغُوثٍ","أَنْ سَقَاهُ كَأْسَ الرَّدَى اسْتِسْقَاءُ"]},{"n":91,"s":["وَأَصَابَ الْوَلِيدَ خَدْشَةُ سَهْمٍ","قَصَّرَتْ عَنْهَا الْحَيَّةُ الرَّقْطَاءُ"]},{"n":92,"s":["وَقَضَتْ شَوْكَةٌ عَلَى مُهْجَةِ الْعَا","صِي فَلِلَّهِ النَّقْعَةُ الشَّوْكَاءُ"]},{"n":93,"s":["وعَلَى الحارِثِ الْقُيُوحُ وَقَدْ سَا","لَ بِهَا رَأْسُهُ وَسَاءَ الْوِعَاءُ"]},{"n":94,"s":["خَمْسَةٌ طُهِرَتْ بِقَطْعِهِمُ الأَرْ","ضُ فَكَفُّ الأَذَى بِهِمْ شَلاَّءُ"]},{"n":95,"s":["فُدِيَتْ خَمْسَةُ الصَّحِيفَةِ بِالْخَمْ","سَةِ إِنْ كَانَ لِلْكِرَامِ فِدَاءُ"]},{"n":96,"s":["فِتْيَةٌ بَيَّتُوا عَلَى فِعْلِ خَيْرٍ","حَمِدَ الصُّبْحُ أَمْرَهُمْ وَالْمَسَاءُ"]},{"n":97,"s":["يَالَ أَمْرٍ أَتَاهُ بَعْدَ هِشَامٍ","زَمْعَةٌ إنَّهُ الْفَتَى الأَتَّاءُ"]},{"n":98,"s":["وَزُهَيرٌ والْمُطْعِمُ بْنُ عَديٍّ","وَأَبُو الْبُحْتُرِيِّ مِنْ حَيْثُ شَاءُوا"]},{"n":99,"s":["نَقَضُوا مُبْرَمَ الصَّحِيفَةِ إِذْ شَ","دَّتْ عَلَيْهِمْ مِنَ الْعِدَا الأَنْدَاءُ"]},{"n":100,"s":["أَذْكَرَتْنَا بِأَكْلِهَا أَكْلَ مِنْسَا","ةِ سُلَيْمَانَ الأَرْضَةُ الْخَرْسَاءُ"]},{"n":101,"s":["وَبِهَا أَخْبَرَ النَّبِيُّ وَكَمْ أَخْ","رَجَ خَبْئاً لَهُ الغُيُوبُ خِبَاءُ"]},{"n":102,"s":["لاَ تَخَلْ جَانِبَ النَّبِيِّ مُضَاماً","حِينَ مَسَّتْهُ مِنْهُمُ الأَسْوَاءُ"]},{"n":103,"s":["كُلُّ أَمْرٍ نَابَ النَّبِيئِينَ فَالشِّ","دَّةُ فِيهِ مَحْمُودَةٌ وَالرَّخَاءُ"]},{"n":104,"s":["لَوْ يَمَسُّ النُّضَارَ هَوْنٌ مِنَ النَّا","رِ لَمَا اخْتِيرَ لِلنُّضَارِ الصِّلاَءُ"]},{"n":105,"s":["كَمْ يَدٍ عَنْ نَبِيِّهِ كَفَّهَا اللهُ","وَفِي الْخَلْقِ كَثْرَةٌ وَاجْتِرَاءُ"]},{"n":106,"s":["إِذْ دَعَا وَحْدَهُ الْعِبَادَ وَأَمْسَتْ","مِنْهُ فِي كُلِّ مُقْلَةٍ أَقْذَاءُ"]},{"n":107,"s":["هَمَّ قَوْمٌ بِقَتْلِهِ فَأَبَى السَّيْ","فُ وَفَاءً وَفَاءَتِ الصَّفْوَاءُ"]},{"n":108,"s":["وَأَبُو جَهْلٍ إذْ رَأَى عُنُقَ الْفَحْ","لِ إِلَيْهِ كَأَنَّهُ الْعَنْقَاءُ"]},{"n":109,"s":["وَاقْتَضَاهُ النَّبِيُّ دَيْنَ الإِرَاشِ","يِّ وَقَدْ سَاءَ بَيْعُهُ وَالشِّرَاءُ"]},{"n":110,"s":["وَرَأَى الْمُصْطَفَى أَتَاهُ بِمَا لَمْ","يُنْجِ مِنْهُ دُونَ الْوَفَاءِ النَّجَاءُ"]},{"n":111,"s":["هُوَ مَا قَدْ رَآهُ مِنْ قَبْلُ لَكِنْ","مَا عَلَى مِثْلِهِ يُعَدُّ الْخَطَاءُ"]},{"n":112,"s":["وَأَعَدَّتْ حَمَّالَةُ الْحَطَبِ الْفِهْ","رَ وَجَاءَتْ كَأَنَّهَا الْوَرْقَاءُ"]},{"n":113,"s":["يَوْمَ جَاءَتْ غَضْبَى تَقولُ أَفِي مِثْ","لِيَ مِنْ أَحْمَدٍ يُقَالُ الهِجَاءُ"]},{"n":114,"s":["وَتَوَلَّتْ وَمَا رَأَتْهُ وَمِنْ أَيْ","نَ تَرَى الشَّمْسَ مُقْلَةٌ عَمْيَاءُ"]},{"n":115,"s":["ثُمَّ سَمَّتْ لَهُ الْيَهُودِيَةَ الشَّا","ةَ وَكَمْ سَامَ الشِّقْوَةَ الأَشْقِيَاءُ"]},{"n":116,"s":["فَأَذَاعَ الذِّرَاعُ مَا فِيهِ مِنْ شَ","رٍّ بِنُطْقٍ إِخْفَاؤُهُ إِبْدَاءُ"]},{"n":117,"s":["وَبِخُلْقٍ مِنَ النَّبِيِّ كَرِيمٍ","لَمْ تُقَاصَصْ بِجَرْحِهَا الْعَجْمَاءُ"]},{"n":118,"s":["مَنَّ فَضْلاً عَلَى هَوَازِنَ إِذْ كَا","نَ لَهُ قَبْلَ ذَاكَ فِيهِمْ رَبَاءُ"]},{"n":119,"s":["وَأَتَى السَّبْيُ فِيهِ أُخْتُ رَضَاعٍ","وَضَعَ الْكُفْرُ قَدْرَهَا والسِّبَاءُ"]},{"n":120,"s":["فَحَبَاهَا بِرّاً تَوَهَّمَتِ النَّا","سُ بِهِ أَنَّمَا السِّبَاءُ هِدَاءُ"]},{"n":121,"s":["بَسَطَ المُصْطَفَى لَهَا مِنْ رِدَاءٍ","أَيُّ فَضْلٍ حَوَاهُ ذَاكَ الرّدَاءُ"]},{"n":122,"s":["فَغَدَتْ فِيهِ وَهْيَ سَيِّدَةُ النِّسْ","وَةِ وَالسَّيِّدَاتُ فِيهِ إِمَاءُ"]},{"n":123,"s":["فَتَنَزَّهْ فِي ذَاتِهِ وَمَعَانِي","هِ اسْتِمَاعًا إِنْ عَزَّ مِنْهَا اجْتِلَاءُ"]},{"n":124,"s":["وَامْلإِ السَّمْعَ مِنْ مَحَاسِنَ يُمْلِي","هَا عَلَيْكَ الإِنْشَادُ وَالإِنشَاءُ"]},{"n":125,"s":["كُلُّ وَصْفٍ لَهُ ابْتَدَأْتُ بِهِ اسْتَوْ","عَبَ أَخْبَارَ الْفَضْلِ مِنْهُ ابْتِدَاءُ"]},{"n":126,"s":["سَيِّدٌ ضِحْكُهُ التَّبَسُّمُ والْمَشْ","يُ الْهُوَيْنَا وَنَوْمُهُ الإِغْفَاءُ"]},{"n":127,"s":["مَا سِوَى خُلْقِهِ النَّسِيمُ وَلاَغَيْ","رِ مُحَيَّاهُ الرَّوْضَةُ الْغَنّاءُ"]},{"n":128,"s":["رَحْمَةٌ كُلُّهُ وَحَزْمٌ وَعَزْمٌ","وَوَقَارٌ وَعِصْمَةٌ وَحَيَاءُ"]},{"n":129,"s":["لاَتَحُلُّ الْبَأْسَاءُ مِنْهُ عُرَى الصَّبْ","رِ وَلاَ تَسْتَخِفُّهُ السَّرَّاءُ"]},{"n":130,"s":["كَرُمَتْ نَفْسُهُ فَمَا يَخْطُرُ السُّو","ءُ عَلَى قَلْبِهِ وَلاَ الْفَحْشَاءُ"]},{"n":131,"s":["عَظُمَتْ نِعْمَةُ الإِلَهِ عَلَيْهِ","فَاسْتُقِلَّتْ لِذِكْرِهِ الْعُظَمَاءُ"]},{"n":132,"s":["جَهِلَتْ قَوْمُهُ عَلَيْهِ فَأَغْضَى","وَأَخُو الحِلْمِ دَأْبُهُ الإِغْضَاءُ"]},{"n":133,"s":["وَسِعَ الْعَالَمِينَ عِلْماً وَحِلْماَ","فَهْوَ بَحْرٌ لَمْ تُعْيِهِ الأَعْبَاءُ"]},{"n":134,"s":["مُسْتَقِلٌ دُنْيَاكَ أَنْ يُنْسَبَ الإِمْ","سَاكُ مِنْهَا إِلَيْهِ والإِعْطَاءُ"]},{"n":135,"s":["شَمْسُ فَضْلٍ تَحَقَّقَ الظَّنُّ فِيهِ","أَنَّهُ الشَّمْسُ رِفْعَةً وَالضِّيَاءُ"]},{"n":136,"s":["فَإِذَا مَا ضَحَا مَحَى نُورُهُ الظِّ","لَّ وَقَدْ أَثْبَتَ الظّلاَلَ الضَّحَاءُ"]},{"n":137,"s":["فَكَأَنَّ الْغَمَامَةَ اسْتَوْدَعَتْهُ","مَنْ أَظَلَّتْ مِنْ ظِلِّهِ الدُّفَفَاءُ"]},{"n":138,"s":["خَفِيَتْ عِنْدَهُ الْفَضَائِلُ وَانْجَا","بَتْ بِهِ عَنْ عُقُولِنَا الأَهْوَاءُ"]},{"n":139,"s":["أَمَعَ الصُّبْحِ لِلنُّجُومِ تَجَلٍّ","أَمْ مَعَ الشَّمْسِ لِلظَّلاَمِ بَقَاءُ"]},{"n":140,"s":["مُعْجِزُ الْقَوْلِ وَالْفِعَالِ كَرِيمُ","الْخَلْقِ وَالْخُلْقِ مُقْسِطٌ مِعْطَاءُ"]},{"n":141,"s":["لاَ تَقِسْ بِالنَّبِيِّ فِي الْفَضْلِ خَلْقاً","فَهُوَ الْبَحْرُ وَالأَنَامُ إِضَاءُ"]},{"n":142,"s":["كُلُّ فَضْلٍ فِي الْعَالَمِينَ فَمِنْ فَضْ","لِ النَّبِيِّ اسْتَعَارَهُ الْفُضَلاَءُ"]},{"n":143,"s":["شُقَّ عَنْ صَدْرِهِ وَشُقَّ لَهُ الْبَدْ","رُ وَمِنْ شَرْطِ كُلِّ شَرْطٍ جَزَاءُ"]},{"n":144,"s":["وَرَمَى بِالْحَصَى فَأَقْصَدَ جَيْشاً","مَا الْعَصَا عِنْدَهُ وَمَا الإِلْقَاءُ"]},{"n":145,"s":["وَدَعَا لِلأَنَامِ إِذْ دَهَمَتْهُمْ","سَنَةٌ مِنْ مُحُولِهَا شَهْبَاءُ"]},{"n":146,"s":["فَاسْتَهَلَّتْ بِالْغَيْثِ سَبْعَةَ أَيَّا","مٍ عَلَيْهِمْ سَحَابَةٌ وَطْفَاءُ"]},{"n":147,"s":["تَتَحَرَّى مَوَاضِعَ الرَّعْيِ والسَّقْيِ","وَحَيْثُ الْعِطَاشُ تُوهَى السِّقَاءُ"]},{"n":148,"s":["وَأَتَى النّاسُ يَشْتَكُونَ أَذَاهَا","وَرَخَاءٌ يُؤْذِي الأَنَامَ غَلاَءُ"]},{"n":149,"s":["فَدَعَا فَانْجَلَى الْغَمَامُ فَقُلْ فِي","وَصْفِ غَيْثٍ إِقْلاَعُهُ اسْتِسْقَاءُ"]},{"n":150,"s":["ثُمَّ أَثْرَى الثَّرَى فَقَرَّتْ عُيُونٌ","بِقُرُاهُا وَأُحْيِيَتْ أَحْيَاءُ"]},{"n":151,"s":["فَتَرَى الأَرْضَ غِبَّهُ كَسَمَاءٍ","أَشْرَقَتْ مِنْ نُجُومِهَا الظَّلْمَاءُ"]},{"n":152,"s":["تُخْجِلُ الدُّرَّ وَالْيَوَاقِيتَ مِنْ نَوْ","رِ رُبَاهَا الْبَيْضَاءُ وَالْحَمْرَاءُ"]},{"n":153,"s":["لَيْتَهُ خَصَّنِي بِرُؤْيَةِ وَجْهٍ","زَالَ عَنْ كُلِّ مَنْ رَآهُ الشَّقَاءُ"]},{"n":154,"s":["مُسْفِرٍ يَلْتَقِي الْكَتِيبَةَ بَسَّا","ماً إِذَا أَسْهَمَ الْوُجُوهَ اللِّقَاءُ"]},{"n":155,"s":["جُعِلَتْ مَسْجِداً لَهُ الأَرْضُ فَاهْتَ","زَّ بِهِ لِلصَّلاَةِ فِيهَا حِرَاءُ"]},{"n":156,"s":["مُظْهِرٍ شَجَّةَ الْجَبِينِ عَلَى الْبُرْ","ءِ كَمَا أَظْهَرَ الْهِلاَلَ الْبَرَاءُ"]},{"n":157,"s":["سُتِرَ الْحُسْنُ مِنْهُ بِالْحُسْنِ فَاعْجَب","لِجَمَالٍ لَهُ الْجَمَالُ وِقَاءُ"]},{"n":158,"s":["فَهْوَ كَالزَّهْرِ لاَحَ مِنْ سَجَفِ الأَكْ","مَامِ وَالْعُودِ شُقَّ عَنْهُ اللِّحَاءُ"]},{"n":159,"s":["كَادَ أَنْ يُغْشَيَ الْعُيُونَ سَنىً مِنْ","هُ لِسِرٍّ حَكَتْهُ فِيهِ ذُكَاءُ"]},{"n":160,"s":["صَانَهُ الْحُسْنُ وَالسَّكِينَةُ أَنْ تُظْ","هِرَ فِيهِ آثَارَهَا الْبَأْسَاءُ"]},{"n":161,"s":["وَتَخَالُ الْوُجُوهَ إِنْ قَابَلَتْهُ","أَلْبَسَتْهَا أَلْوَانَهَا الْحِرْبَاءُ"]},{"n":162,"s":["فَإِذَا شِمْتَ بِشْرَهُ وَنَدَاهُ","أَذْهَلَتْكَ الأَنْوَارُ وَالأَنْوَاءُ"]},{"n":163,"s":["أَوْ بِتَقْبِيلِ رَاحَةٍ كَانَ للهِ","وَبِاللهِ أَخْذُهَا وَالْعَطَاءُ"]},{"n":164,"s":["تَتَّقِي بَأْسَهَا الْمُلُوكُ وَتَحْظَى","بِالْغِنَا مِنْ نَوَالِهَا الْفُقَرَاءُ"]},{"n":165,"s":["لاَ تَسَلْ سَيْلَ جُودِهَا إِنَّمَا يَكْ","فِيكَ مِنْ وَكْفِ سُحْبِهَا الأَنْدَاءُ"]},{"n":166,"s":["دَرَّتِ الشَّاةُ حِينَ مَرَّتْ عَلَيْهَا","فَلَهَا ثَرْوَةٌ بِهَا وَنَمَاءُ"]},{"n":167,"s":["نَبَعَ الْمَاءُ أَثْمَرَ النَّخْلُ فِي عَا","مٍ بِهَا سَبَّحَتْ بِهَا الْحَصْبَاءُ"]},{"n":168,"s":["أَحْيَتِ الْمُرْمِلِينَ مِنْ مَوْتِ جَهْدٍ","أَعْوَزَ الْقَوْمَ فِيهِ زَادٌ وَمَاءُ"]},{"n":169,"s":["فَتَغَذَّى بِالصَّاعِ أَلْفٌ جِيَاعٌ","وَتَرَوَّى بِالصَّاعِ أَلْفٌ ظِمَاءُ"]},{"n":170,"s":["وَوَفَى قَدْرُ بَيْضَةٍ مِنْ نُضَارٍ","دَيْنَ سَلْمَانَ حِينَ حَانَ الْوَفَاءُ"]},{"n":171,"s":["كَانَ يُدْعَى قِنّاً فَأَعْتَقَ لَمَّا","أَيْنَعَتْ مِنْ نَخِيلِهِ الأَقْنَاءُ"]},{"n":172,"s":["أَفَلاَ تَعْذُرُونَ سَلْمَانَ لَمَّا","أَنْ عَرَتْهُ مِنْ ذِكْرِهِ الْعُرَوَاءُ"]},{"n":173,"s":["وَأَزَالتْ بِلَمْسِهَا كُلَّ دَاءٍ","أَكْبَرَتْهُ أَطِبَّةٌ وَإِسَاءُ"]},{"n":174,"s":["وَعُيُونٌ مَرَّتْ بِهَا وَهْيَ رُمْدٌ","فَأَرَتْهَا مَا لَمْ تَرَ الزَّرْقَاءُ"]},{"n":175,"s":["وَأَعَادَتْ عَلَى قَتَادَةَ عَيْناً","فَهْيَ حَتَّى مَمَاتِهِ النَّجْلاَءُ"]},{"n":176,"s":["أَوْ بِلَثْمِ التُّرَابِ مِنْ قَدَمٍ لاَ","نَتْ حَياءً مِنْ مَشْيِهَا الصَّفْوَاءُ"]},{"n":177,"s":["مَوْطِئُ الْأَخْمُصِ الَّذِي مِنْهُ لِلْقَلْ","بِ إِذَا مَضْجَعِي أَقَضَّ وِطَاءُ"]},{"n":178,"s":["حَظِيَ الْمَسْجِدُ الْحَرَامُ بِمَمْشَا","هَا وَلَمْ يَنْسَ حَظَّهُ إِيلْيَاءُ"]},{"n":179,"s":["وَرِمَتْ إِذْ رَمَى بِهَا ظِلَمَ اللَّيْ","لِ إِلَى اللهِ خَوْفُهُ وَالرَّجَاءُ"]},{"n":180,"s":["دَمِيَتْ فِي الْوَغَى لِتُكْسِبَ طِيباً","مَا أَرَاقَتْ مِنَ الدَّمِ الشُّهَدَاءُ"]},{"n":181,"s":["فَهْيَ قُطْبُ الْمِحْرَابِ وَالْحَرْبِ كَمْ دَا","رَتْ عَلَيْهَا فِي طَاعَةٍ أَرْحَاءُ"]},{"n":182,"s":["وَأُرَاهُ لَوْ لَمْ يُسَكِّنْ بِهَا قَبْ","لُ حِرَاءً مَاجَتْ بِهِ الدَّأْمَاءُ"]},{"n":183,"s":["عَجَباً لِلْكُفَّارِ زَادُوا ضَلَالًا","بِالذِي لِلْعُقُولِ فِيهِ اهْتِدَاءُ"]},{"n":184,"s":["والذِي يَسْأَلُونَ مِنْهُ كِتَابٌ","مُنْزَلٌ قَدْ أَتَاهُمُ وَارْتِقَاءُ"]},{"n":185,"s":["أَوَلَمْ يَكْفِهِمْ مِنَ اللهِ ذِكْرٌ","فِيهِ لِلنَّاسِ رَحْمَةٌ وَشِفَاءُ"]},{"n":186,"s":["أَعْجَزَ الإِنْسَ آيَةٌ مِنْهُ وَالْجِ","نَّ فَهَلاَّ تَأْتِي بِهَا الْبُلَغَاءُ"]},{"n":187,"s":["كُلَّ يَوْمٍ تُهْدِي إِلَى سَامِعِيهِ","مُعْجِزَاتٍ مِنْ لَفْظِهِ الْقُرَّاءُ"]},{"n":188,"s":["تَتَحَلَّى بِهِ الْمَسَامِعُ والأَفْ","وَاهُ فَهْوَ الْحُلِيُّ وَالْحَلْوَاءُ"]},{"n":189,"s":["رَقَّ لَفْظاً وَرَاقَ مَعْنىً فَجَاءَتْ","فِي حُلاَهَا وَحَلْيِهَا الْخَنْسَاءُ"]},{"n":190,"s":["وَأَرَتْنَا فِيهِ غَوَامِضَ فَضْلٍ","رِقَّةٌ مِنْ زُلاَلِهَا وَصَفَاءُ"]},{"n":191,"s":["إِنَّمَا تُجْتَلَى الْوُجُوهُ إِذَا مَا","جُلِيَتْ عَنْ مِرْآتِهَا الأَصْدَاءُ"]},{"n":192,"s":["سُوَرٌ مِنْهُ أَشْبَهَتْ صُوَراً مِ","نَّا وَمِثْلُ النَّظَائِرِ النُّظَرَاءُ"]},{"n":193,"s":["وَالأَقَاوِيلُ عِنْدَهُمْ كَالتَّمَاثِي","لِ فَلاَ يُوهِمَنَّكَ الْخُطَبَاءُ"]},{"n":194,"s":["كَمْ أَبَانَتْ آيَاتُهُ مِنْ عُلُومٍ","عَنْ حُرُوفٍ أَبَانَ عَنْهَا الْهِجَاءُ"]},{"n":195,"s":["فَهْيَ كَالْحَبِّ وَالنَّوَى أَعْجَبَ الزُّ","رَّاعَ مِنْهُ سَنَابِلٌ وَزَكَاءُ"]},{"n":196,"s":["فَأَطَالُوا فِيهِ التَّرَدُّدَ والرَّيْ","بَ فَقَالُوا سِحْرٌ وَقَالُوا افْتِرَاءُ"]},{"n":197,"s":["وَإِذَا الْبَيِّنَاتُ لَمْ تُغْنِ شَيْئاً","فَالْتِمَاسُ الْهُدَى بِهِنَّ عَنَاءُ"]},{"n":198,"s":["وَإِذَا ضَلَّتِ الْعُقُولُ عَلَى عِلْ","مٍ فَمَاذَا تَقُولُهُ النُّصَحَاءُ"]},{"n":199,"s":["قَوْمَ عِيسَى عَامَلْتُمُ قَوْمَ مُوسَى","بِالذِي عَامَلَتْكُمُ الْحُنَفَاءُ"]},{"n":200,"s":["صَدَّقُوا كُتْبَكُمُ وَكَذَّبْتُمُ كُتْ","بَهُمُ إِنَّ ذَا لَبِئْسَ الْبَوَاءُ"]},{"n":201,"s":["لَوْ جَحَدْنَا جُحُودَكُمُ لاَسْتَوَيْنَا","أَوَ لِلْحَقِّ بِالضَّلاَلِ اسْتِوَاءُ"]},{"n":202,"s":["مَالَكُمْ إِخْوَةَ الْكِتَابِ أُنَاساً","لَيْسَ يُرْعَى لِلْحَقِّ مِنْكُمْ إخَاءُ"]},{"n":203,"s":["يَحْسُدُ الأَوَّلُ الأَخِيرَ وَمَا زَا","لَ كَذَا الْمُحْدَثُونَ وَالْقُدَمَاءُ"]},{"n":204,"s":["قَدْ عَلِمْتُمْ بِظُلْمِ قَابِيلَ هَابِي","لَ وَمَظْلُومَ الإِخْوَةِ الأَتْقِيَاءُ"]},{"n":205,"s":["وَسَمِعْتُمْ بِكَيْدِ أَبْنَاءِ يَعْقُو","بَ أَخَاهُمْ وَكُلُّهُمْ صُلَحَاءُ"]},{"n":206,"s":["حِينَ أَلْقَوْهُ فِي غَيَابَةِ جُبٍّ","وَرَمَوْهُ بِالإِفْكِ وَهْوَ بَرَاءُ"]},{"n":207,"s":["فَتَأَسَّوْا بِمَنْ مَضَى إِذْ ظُلِمْتُمْ","فَالتَّأَسِّي لِلنَّفْسِ فِيهِ عَزَاءُ"]},{"n":208,"s":["أَتَراكُمْ وَفَّيْتُمُ حِينَ خَانُوا","أَمْ تُرَاكُمْ أَحْسَنْتُمُ إِذْ أَسَاءوا"]},{"n":209,"s":["بَلْ تَمَادَتْ عَلَى التَّجَاهُلِ آبَا","ءٌ تَقَفَّتْ آثَارَهَا الأَبْنَاءُ"]},{"n":210,"s":["بَيَّنَتْهُ تَوْرَاتُهُمْ وَالأَنَاجِي","لُ وَهُمْ فِي جُحُودِهِ شُرَكَاءُ"]},{"n":211,"s":["إِنْ تَقُولُوا مَا بَيَّنَتْهُ فَمَا زَا","لَتْ بِهَا عَنْ عُيُونِهِمْ غَشْوَاءُ"]},{"n":212,"s":["أَوْ تَقُولُوا قَدْ بَيَّنَتْهُ فَمَا لِلْ","أُذْنِ عَمَّا تَقُولُهُ صَمَّاءُ"]},{"n":213,"s":["عَرَفُوهُ وَأَنْكَرُوهُ وَظُلْماً","كَتَمَتْهُ الشَّهَادَةَ الشُّهَدَاءُ"]},{"n":214,"s":["أَوَ نُورَ الإِلَهِ تُطْفِئُهُ الأَفْ","وَاهُ وَهْوَ الذِي بِهِ يُسْتَضَاءُ"]},{"n":215,"s":["أَوَ لاَ يُنْكِرُونَ مَنْ طَحَنَتْهُمْ","بِرَحَاهَا عَنْ أَمْرِهِ الْهَيْجَاءُ"]},{"n":216,"s":["وَكَسَاهُمْ ثَوْبَ الصَّغَارِ وَقَدْ طُلْ","لَتْ دِماً مِنْهُمُ وَصِينَتْ دِمَاءُ"]},{"n":217,"s":["كَيْفَ يَهْدِي الإِلَهُ مِنْهُمْ قُلُوباً","حَشْوُهَا مِنْ حَبِيبِهِ الْبَغْضَاءُ"]},{"n":218,"s":["خَبِّرُونَا أَهْلَ الْكِتَابَيْنِ مِنْ أَيْ","نَ أَتَاكُمْ تَثْلِيثُكُمْ وَالْبَدَاءُ"]},{"n":219,"s":["مَا أَتَى بِالْعَقِيدَتَيْنِ كِتَابٌ","وَاعْتِقَادٌ لاَ نَصَّ فِيهِ ادِّعَاءُ"]},{"n":220,"s":["وَالدَّعَاوِي مَا لَمْ تُقِيمُوا عَلَيْهَا","بَيِّنَاتٍ أَبْنَاؤُهَا أَدْعِيَاءُ"]},{"n":221,"s":["لَيْتَ شِعْرِي ذِكْرُ الثَّلاَثَةِ وَالْوَا","حِدِ نَقْصٌ فِي عَدِّكُمْ أَمْ نَمَاءُ"]},{"n":222,"s":["كَيْفَ وَحَّدْتُمُ إِلَهاً نَفَى التَّوْ","حِيدَ عَنْهُ الآبَاءُ وَالأَبْنَاءُ"]},{"n":223,"s":["أَإِلَهٌ مُرَكَّبٌ مَا سَمِعْنَا","بِإِلَهٍ لِذَاتِهِ أَجْزَاءُ"]},{"n":224,"s":["أَلِكُلٍّ مِنْهُمْ نَصِيبٌ مِنَ الْمُلْ","كِ فَهَلاَّ تُمَيَّزُ الأَنْصِبَاءُ"]},{"n":225,"s":["أَتُرَاهُمْ لِحَاجَةٍ وَاضْطِرَارٍ","خَلَطُوهَا وَمَا بَغَى الْخُلَطَاءُ"]},{"n":226,"s":["أَهُوَ الرَّاكِبُ الْحِمَارَ فَيَا عَجْ","زَ إِلَهٍ يَمَسُّهُ الإِعْيَاءُ"]},{"n":227,"s":["أَمْ جَمِيعٌ عَلَى الْحِمَارِ لَقَدْ جَ","لَّ حِمَارٌ بِجَمْعِهِمْ مَشَّاءُ"]},{"n":228,"s":["أَمْ سِوَاهُمْ هُوَ الإِلَهُ فَمَا نِسْ","بَةُ عِيسَى إِلَيْهِ وَالإِنْتِمَاءُ"]},{"n":229,"s":["أَمْ أَرَدْتُمْ بِهَا الصِّفَاتِ فَلِمْ خُصْ","صَتْ ثُلاَثٌ بِوَصْفِهِ وَثُنَاءُ"]},{"n":230,"s":["أَمْ هُوَ ابْنٌ للهِ مَا شَارَكَتْهُ","فِي مَعَانِي الْبُنُوَّةِ الأَنْبِيَاءُ"]},{"n":231,"s":["قَتَلَتْهُ الْيَهُودُ فِيمَا زَعَمْتُمْ","وَلأَمْوَاتِكُمْ بِهِ إِحْيَاءُ"]},{"n":232,"s":["إِنَّ قَوْلاً أَطْلَقْتُمُوهُ عَلَى اللَّ","هِ تَعَالَى ذِكْراً لَقَوْلٌ هُرَاءُ"]},{"n":233,"s":["مِثْلَ مَا قَالَتِ الْيَهُودُ وَكُلٌّ","لَزِمَتْهُ مَقَالَةٌ شَنْعَاءُ"]},{"n":234,"s":["إِذْ هُمُ اسْتَقْرَؤُوا الْبَدَاءَ وَكَمْ سَا","قَ وَبَالاً إِلَيْهِمُ اسْتِقْرَاءُ"]},{"n":235,"s":["وَأَرَاهُمْ لَمْ يَجْعَلُوا الْوَاحِدَ الْقَ","هَّارَ فِي الْخَلْقِ فَاعِلاً مَا يَشَاءُ"]},{"n":236,"s":["جَوَّزُوا النَّسْخَ مِثْلَ مَا جَوَّزُوا الْمسْ","خَ عَلَيْهِمْ لَوْ أَنَّهُمْ فُقَهَاءُ"]},{"n":237,"s":["هُوَ إِلاَّ أَنْ يُرْفَعَ الْحُكْمُ بِالْحُ","كْمِ وَخَلْقٌ فِيهِ وَأَمْرٌ سَوَاءُ"]},{"n":238,"s":["وَلِحُكْمٍ مِنَ الزَّمَانِ انْتِهَاءٌ","وَلِحُكْمٍ مِنَ الزَّمَانِ ابْتِدَاءُ"]},{"n":239,"s":["فَسَلُوهُمْ أَكَانَ فِي مَسْخِهِمْ نَسْ","خٌ لِآيَاتِ اللهِ أَمْ إِنْشَاءُ"]},{"n":240,"s":["وَبَدَاءٌ فِي قَوْلِهِمْ نَدِمَ اللَّ","هُ عَلَى خَلْقِ آدَمَ أَمْ خَطَاءُ"]},{"n":241,"s":["أَمْ مَحَا اللهُ آيَةَ اللَّيْلِ ذُكْراً","بَعْدَ سَهْوٍ لِيُوجَدَ الإِمْسَاءُ"]},{"n":242,"s":["أَمْ بَدَا لِلإِلَهِ فِي ذَبْحِ إِسْحَا","قَ وَقَدْ كَانَ الأَمْرُ فِيهِ مَضَاءُ"]},{"n":243,"s":["أَوَ مَا حَرَّمَ الإِلَهُ نِكَاحَ الأُخْ","تِ بَعْدَ التَّحْلِيلِ فَهْوَ الزِّنَاءُ"]},{"n":244,"s":["لاَ تُكَذِّبْ أَنَّ الْيَهُودَ وَقَدْ زَا","غُوا عَنِ الْحَقِّ مَعْشَرٌ لُؤُمَاءُ"]},{"n":245,"s":["جَحَدُوا الْمُصْطَفَى وَآمَنَ بالطَّا","غُوتِ قَومٌ هُمْ عِنْدَهُمْ شُرَفَاءُ"]},{"n":246,"s":["قَتَلُوا الأَنْبِيَاءَ وَاتَّخَذُوا الْعِجْ","لَ أَلاَ إِنَّهُمْ هُمُ السُّفَهَاءُ"]},{"n":247,"s":["وَسَفِيهٌ مَنْ سَاءَهُ الْمَنُّ والسَّلْ","وَى وَأَرْضَاهُ الْفُومُ والْقِثَّاءُ"]},{"n":248,"s":["مُلِئَتْ بِالْخَبِيثِ مِنْهُمْ بُطُونٌ","فَهْيَ نَارٌ طِبَاقُهَا الأَمْعَاءُ"]},{"n":249,"s":["لَوْ أُرِيدُوا فِي حَالِ سَبْتٍ بِخَيْرٍ","كَانَ سَبْتاً لَدَيْهِمُ الأَرْبِعَاءُ"]},{"n":250,"s":["هُوَ يَوْمٌ مُبَارَكٌ قِيلَ لِلتَّصْ","رِيفِ فِيهِ مِنَ الْيَهُودِ اعْتِدَاءُ"]},{"n":251,"s":["فَبِظُلْمٍ مِنْهُمْ وَكُفْرٍ عَدَتْهُمْ","طَيِّبَاتٌ فِي تَرْكِهِنَّ ابْتِلاَءُ"]},{"n":252,"s":["خُدِعُوا بِالْمُنَافِقِينَ وَهَلْ يُنْ","فَقُ إِلاَّ عَلَى السَّفِيهِ الشَّقَاءُ"]},{"n":253,"s":["وَاطْمَأَنُّوا بِقَوْلِ الأَحْزَابِ إِخْوَا","نِهِمُ إِنَّنَا لَكُمْ أَوْلِيَاءُ"]},{"n":254,"s":["حَالَفُوهُمْ وَخَالَفُوهُمْ وَلَمْ أَدْ","رِ لِمَاذَا تَخَالَفَ الْحُلَفَاءُ"]},{"n":255,"s":["أَسْلَمُوهُمْ لأَوَّلِ الْحَشْرِ لاَ مِي","عَادُهُمْ صَادِقٌ وَلاَ الإِيلاَءُ"]},{"n":256,"s":["سَكَنَ الرُّعْبُ وَالْخَرَابُ قُلُوباً","وَبُيُوتاً مِنْهُمْ نَعَاهَا الْجَلاَءُ"]},{"n":257,"s":["وَبِيَوْمِ الأَحْزَابِ إِذْ زَاغَتِ الأَبْ","صَارُ فِيهِ وَضَلَّتِ الآرَاءُ"]},{"n":258,"s":["وَتَعَدَّوْا إِلَى النَّبِيِّ حُدُوداً","كَانَ فِيهَا عَلَيْهِمُ الْعَدْوَاءُ"]},{"n":259,"s":["وَنَهَتْهُمْ وَمَا انْتَهَتْ عَنْهُ قَوْمٌ","فَأُبِيدَ الأَمَّارُ وَالنَّهَّاءُ"]},{"n":260,"s":["وَتَعَاطَوْا فِي أَحْمَدٍ مُنْكَرَ الْقَوْ","لِ وَنُطْقُ الأَرَاذِلِ الْعَوْرَاءُ"]},{"n":261,"s":["كُلُّ رِجْسٍ يَزِيدُهُ الْخُلُقُ السُّو","ءُ سِفَاهاً وَالْمِلَّةُ الْعَوْجَاءُ"]},{"n":262,"s":["فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْقَوْ","مِ وَمَا سَاقَ لِلبَذِيِّ الْبَذَاءُ"]},{"n":263,"s":["وَجَدَ السَّبَّ فِيهِ سُمّاً وَلَمْ يَدْ","رِ إِذِ الْمِيمُ فِي مَوَاضِعَ بَاءُ"]},{"n":264,"s":["كَانَ مِنْ فِيهِ قَتْلُهُ بِيَدَيْهِ","فَهْوَ فِي سُوءِ فِعْلِهِ الزَّبَّاءُ"]},{"n":265,"s":["أَوْ هُوَ النَّحْلُ قَرْصُهَا يَجْلِبُ الْحَتْ","فَ إِلَيْهَا وَمَا لَهُ إِنْكَاءُ"]},{"n":266,"s":["صَرَعَتْ قَوْمَهُ حَبَائِلُ بَغْيٍ","مَدَّهَا الْمَكْرُ مِنْهُمُ وَالدَّهَاءُ"]},{"n":267,"s":["فَأَتَتْهُمْ خَيْلٌ إِلَى الحَرْبِ تَخْ","تَالُ وَلِلْخَيْلِ فِي الْوَغَى خُيَلاَءُ"]},{"n":268,"s":["قَصَدَتْ فِيهِمُ الْقَنا فَقَوَافِي","الطَّعْنِ مِنْهَا مَا شَانَهَا الإِيطَاءُ"]},{"n":269,"s":["وَأَثَارَتْ بِأَرْضِ مَكَّةَ نَقْعاً","ظُنَّ أَنَّ الغُدُوَّ مِنْهَا عِشَاءُ"]},{"n":270,"s":["أَحْجَمَتْ عِنْدَهَا الْحَجُونُ وَأَكْدَى","عِنْدَ إِعْطَائِهِ الْقَلِيلَ كُدَاءُ"]},{"n":271,"s":["وَدَهَتْ أَوْجُهاً بِهَا وَبُيُوتاً","مُلَّ مِنْهَا الإِكْفَاءُ وَالإِقْوَاءُ"]},{"n":272,"s":["فَدَعَوْا أَحْلَمَ الْبَرِيَّةِ والْعَفْ","وُ جَوَابُ الْحَلِيمِ وَالإِغْضَاءُ"]},{"n":273,"s":["نَاشَدُوهُ الْقُرْبَى التِي مِنْ قُرَيْشٍ","قَطَعَتْهَا التِّراتُ وَالشَّحْنَاءُ"]},{"n":274,"s":["فَعَفَا عَفْوَ قَادِرٍ لَمْ يُنَغِّصْ","هُ عَلَيْهِمْ بِمَا مَضَى إِغْرَاءُ"]},{"n":275,"s":["وَإِذَا كَانَ الْقَطْعُ وَالْوَصْلُ لِل","هِ تَسَاوَى التَّقْرِيبُ وَالإِقْصَاءُ"]},{"n":276,"s":["وَسَوَاءٌ عَلَيْهِ فِيمَا أَتَاهُ","مِنْ سِوَاهُ الْمَلاَمُ وَالإِطْرَاءُ"]},{"n":277,"s":["وَلَوْ أَنَّ انْتِقَامَهُ لِهَوَى النَّف","سِ لَدَامَتْ قَطِيعَةٌ وَجَفَاءُ"]},{"n":278,"s":["قَامَ للهِ فِي الأُمُورِ فَأَرْضَى","اللهَ مِنْهُ تَبَايُنٌ وَوَفَاءُ"]},{"n":279,"s":["فِعْلُهُ كُلُّهُ جَمِيلٌ وَهَلْ يَنْ","ضَحُ إِلاَّ بِمَا حَوَاهُ الإِنَاءُ"]},{"n":280,"s":["أَطْرَبَ السَّامِعِينَ ذِكْرُ عُلاَهُ","يَا لَرَاحٍ مَالَتْ بِهِ النُّدَمَاءُ"]},{"n":281,"s":["النَّبِيُّ الأُمِّيُّ أَعْلَمُ مَنْ أَسْ","نَدَ عَنْهُ الرُّوَّاةُ وَالْحُكَمَاءُ"]},{"n":282,"s":["وَعَدَتْنِي ازْدِيَارَهُ الْعَامَ وَجْنَا","ءُ وَمَنَّتْ بِوَعْدِهَا الْوَجْنَاءُ"]},{"n":283,"s":["أَفَلاَ أَنْطَوِي لَهَا فِي اقْتِضَائِ","هِ لِتُطْوَى مَا بَيْنَنَا الأَفْلاَءُ"]},{"n":284,"s":["بِأَلُوفِ الْبَطْحَاءِ يُجْفِلُهَا النِّي","لُ وَقَدْ شَفَّ جَوْفَهَا الإِظْمَاءُ"]},{"n":285,"s":["أَنْكَرَتْ مِصْرَ فَهْيَ تَنْفِرُ مَا لاَ","حَ بِنَاءٌ لِعَيْنِهَا أَوْ خَلاَءُ"]},{"n":286,"s":["فَأَفَضَّتْ عَلَى مُبَارِكِهَا بِرْ","كَتُهَا فَالْبُوَيْبُ فَالْخَضْرَاءُ"]},{"n":287,"s":["فَالْقِبَابُ التِي تَلِيهَا فَبِئْرُ","النَّخْلِ وَالرَّكْبُ قَائِلُونَ رِوَاءُ"]},{"n":288,"s":["وَغَدَتْ أَيْلَةٌ وَحِقْلٌ وَقَرٌّ","خَلْفَهَا فَالْمَغَارَةُ الْفَيْحَاءُ"]},{"n":289,"s":["فَعُيُونُ الأَقْصَابِ يَتْبَعُهَا النَّبْ","كُ وَتَتْلُو كَفَافَةَ الْعَوْجَاءُ"]},{"n":290,"s":["حَاوَرَتْهَا الْحَوْرَاءُ شَوْقاً فَيُنْبُو","عٌ فَرَقَّ الْيُنْبُوعُ وَالْحَوْرَاءُ"]},{"n":291,"s":["لاَحَ بِالدَّهْنَوَيْنِ بَدْرٌ لَهَا بَعْ","دَ حُنَيْنٍ وَحَنَّتِ الصَّفْرَاءُ"]},{"n":292,"s":["وَنَضَتْ بَزْوَةٌ فَرَابغُ فَالْجُحْ","فَةُ عَنْهَا مَا حَاكَهُ الإِنْضَاءُ"]},{"n":293,"s":["وَأَرَتْهَا الْخَلاَصَ بِئْرُ عَلِيٍّ","فَعُقَابُ السُّوَيْقِ فَالْخُلَصَاءُ"]},{"n":294,"s":["فَهْيَ مِنْ مَاءِ بِئْرِ عُسْفَانَ أَوْ مِنْ","بَطْنِ مَرٍّ ظَمْآنةٌ خَمْصَاءُ"]},{"n":295,"s":["قَرَّبَ الزَّاهِرُ الْمَسَاجِدَ مِنْها","بِخُطَاهَا فَالْبُطْءُ مِنْهَا وَحَاءُ"]},{"n":296,"s":["هَذِهِ عِدَّةُ الْمَنَازِلِ لاَ مَا","عُدَّ فِيهِ السِّمَاكُ وَالْعَوَّاءُ"]},{"n":297,"s":["فَكَأَنِّي بِهَا أُرَحِّلُ مِنْ مَ","كَّةَ شَمْساً سَمَاؤُهَا الْبَيْدَاءُ"]},{"n":298,"s":["مَوْضِعُ الْبَيْتِ مَهْبِطُ الْوَحْيِ مَأْوَى","الرُّسْلِ حَيْثُ الأَنْوَارُ حَيْثُ الْبَهَاءُ"]},{"n":299,"s":["حَيْثُ فَرْضُ الطَّوَافِ وَالسَّعْيُ","وَالْحَلْقُ وَرَمْيُ الْجِمَارِ وَالْإِهْدَاءُ"]},{"n":300,"s":["حَبَّذَا حَبَّذَا مَعَاهِدُ مِنْهَا","لَمْ يُغَيِّرْ آيَاتِهِنَّ الْبَلاَءُ"]},{"n":301,"s":["حَرَمٌ آمِنٌ وَبَيْتٌ حَرَامٌ","وَمَقَامٌ فِيهِ الْمُقَامُ تَلاَءُ"]},{"n":302,"s":["فَقَضَيْنَا بِهَا مَنَاسِكَ لاَ يُحْ","مَدُ إِلاَّ فِي فِعْلِهِنَّ الْقَضَاءُ"]},{"n":303,"s":["وَرَمَيْنَا بِهَا الْفِجَاجَ إِلَى طَيْ","بَةَ وَالسَّيْرُ بِالْمَطَايَا رِمَاءُ"]},{"n":304,"s":["فَأَصَبْنَا عَنْ قَوْسِهَا غَرَضَ الْقُرْ","بِ وَنِعْمَ الْخَبِيئَةُ الْكَوْمَاءُ"]},{"n":305,"s":["فَرَأَيْنَا أَرْضَ الْحَبِيبِ يَغُضُّ","الطَّرْفَ مِنْهَا الضِّيَاءُ واللَّأْلاَءُ"]},{"n":306,"s":["فَكَأَنَّ الْبَيْدَاءَ مِنْ حَيْثُ مَا قَا","بَلَتِ الْعَيْنُ رَوْضَةٌ غَنَّاءُ"]},{"n":307,"s":["وَكَأَنَّ الْبِقَاعَ زُرَّتْ عَلَيْهَا","طَرَفَيْهَا مُلاَءةٌ حَمْرَاءُ"]},{"n":308,"s":["وَكَأَنَّ الأَرْجَاءَ يَنْشُرُ نَشْرَ الْ","مِسْكِ فِيهَا الْجَنُوبُ وَالْجِرْبِيَاءُ"]},{"n":309,"s":["فَإِذَا شِمْتَ أَوْ شَمَمْتَ رُبَاهَا","لاَحَ مِنْهَا بَرْقٌ وَفَاحَ كِبَاءُ"]},{"n":310,"s":["أَيُّ نُورٍ وَأَيَّ نَوْرٍ شَهِدْنَا","يَوْمَ أَبْدَتْ لَنَا الْقِبَابَ قُبَاءُ"]},{"n":311,"s":["قَرَّ مِنْهَا دَمْعِي وَفَرَّ اصْطِبَارِي","فَدُمُوعِي سَيْلٌ وَصَبْرِي جُفَاءُ"]},{"n":312,"s":["فَتَرَى الرَّكْبَ طَائِرِينَ مِنَ الشَّوْ","قِ إِلَى طَيْبَةٍ لَهُمْ ضَوْضَاءُ"]},{"n":313,"s":["فَكَأَنَّ الزُّوَّارَ مَا مَسَّتِ الْبَأْ","سَاءُ مِنْهُمْ خَلْقاً وَلاَ الضَّرَّاءُ"]},{"n":314,"s":["كُلُّ نَفْسٍ مِنْهَا ابْتِهَالٌ وَسُؤْلٌ","وَدُعَاءٌ وَرَغْبَةٌ وَابْتِغَاءُ"]},{"n":315,"s":["وَزَفِيرٌ تَظُنُّ مِنْهُ صُدُوراً","صَادِحَاتٍ يَعْتَادُهُنَّ زُقَاءُ"]},{"n":316,"s":["وَبُكَاءٌ يُغْرِيهِ بِالْعَيْنِ مَدٌّ","وَنَحِيبٌ يَحُثُّهُ اسْتِعْلاَءُ"]},{"n":317,"s":["وَجُسُومٌ كَأَنَّمَا رَحَضَتْهَا","مِنْ عَظِيمِ الْمَهَابَةِ الرُّحَضَاءُ"]},{"n":318,"s":["وَوُجُوهٌ كَأَنَّما أَلْبَسَتْهَا","مِنْ حَيَاءٍ أَلْوَانَهَا الْحِرْبَاءُ"]},{"n":319,"s":["وَدُمُوعٌ كَأَنَّمَا أَرْسَلَتْهَا","مِنْ جُفُونٍ سَحَابَةٌ وَطْفَاءُ"]},{"n":320,"s":["فَحَطَطْنَا الرِّحَالَ حَيْثُ يُحَطُّ","الْوِزْرُ عَنَّا وَتُرْفَعُ الْحَوْجَاءُ"]},{"n":321,"s":["وَقَرَأْنَا السَّلاَمَ أَكْرَمَ خَلْقِ","اللهِ مِنْ حَيْثُ يُسْمَعُ الإِقْرَاءُ"]},{"n":322,"s":["وَذَهِلْنَا عِنْدَ اللِّقَاءِ وَكَمْ أَذْ","هَلَ صَبّاً مِنَ الْحَبِيبِ لِقَاءُ"]},{"n":323,"s":["وَوَجَمْنَا مِنَ الْمَهَابَةِ حَتَّى","لاَ كَلاَمٌ مِنَّا وَلاَ إِيمَاءُ"]},{"n":324,"s":["وَرَجَعْنَا وَلِلْقُلُوبِ الْتِفَاتَا","تٌ إِلَيْهِ وَلِلْجُسُومِ انْثِنَاءُ"]},{"n":325,"s":["وَسَمَحْنَا بِمَا نُحِبُّ وَقَدْ يَسْ","مَحُ عِنْدَ الضَّرُورَةِ الْبُخَلاَءُ"]},{"n":326,"s":["يَا أَبَا الْقَاسِمِ الذِي ضِمْنُ إِقْسَا","مِي عَلَيْهِ مَدْحٌ لَهُ وَثَنَاءُ"]},{"n":327,"s":["بِالْعُلُومِ التِي عَلَيْكُ مِنَ الل","هِ بِلاَ كَاتِبٍ لَهَا إِمْلاَءُ"]},{"n":328,"s":["وَمَسِيرِ الصَّبَا بِنَصْرِكَ شَهْراً","فَكَأَنَّ الصَّبَا لَدَيْكَ رُخَاءُ"]},{"n":329,"s":["وَعَلِيٍّ لَمَّا تَفَلْتَ بِعَيْنَيْ","هِ وَكِلْتَاهُمَا مَعاً رَمْدَاءُ"]},{"n":330,"s":["فَغَدَا نَاظِراً بِعَيْنَيْ عُقَابٍ","فِي غَزَاةٍ لَهَا الْعُقَابُ لِوَاءُ"]},{"n":331,"s":["وَبِرَيْحَانَتَيْنِ طِيبُهُمَا مِنْ","كَ الذِي أُودِعَتْهُمَا الزَّهْرَاءُ"]},{"n":332,"s":["كُنْتَ تُؤْوِيهِمَا إِلَيْكَ كَمَا آ","وَتْ مِنَ الْخَطِّ نُقْطَتَيْهَا الْيَاءُ"]},{"n":333,"s":["مِنْ شَهِيدَيْنِ لَيْسَ يُنْسِينِيَ الطَّ","فُّ مُصَابَيْهِمَا وَلاَ كَرْبَلاَءُ"]},{"n":334,"s":["مَا رَعَى فِيهِمَا ذِمَامَكَ مَرْءُو","سٌ وَقَدْ خَانَ عَهْدَكَ الرُّؤَسَاءُ"]},{"n":335,"s":["أَبْدَلُوا الْوِدَّ وَالْحَفِيظَةَ فِي القُرْ","بَى وَأَبْدَتْ ضِبَابَهَا النَّافِقَاءُ"]},{"n":336,"s":["وَقَسَتْ مِنْهُمُ قُلُوبٌ عَلَى مَنْ","بَكَتِ الأَرْضُ فَقْدَهُمْ وَالسَّمَاءُ"]},{"n":337,"s":["فَابْكِهِمْ مَا اسْتَطَعْتَ إِنَّ قَلِيلاً","فِي عَظِيمٍ مِنَ الْمُصَابِ الْبُكَاءُ"]},{"n":338,"s":["كُلَّ يَوْمٍ وَكُلُّ أَرْضٍ لِكَرْبِي","مِنْهُمُ كَرْبَلاَ وَعَاشُورَاءُ"]},{"n":339,"s":["آلَ بَيْتِ النَّبِيِّ إِنَّ فُؤَادِي","لَيْسَ يُسْلِيهِ عَنْكُمُ التَّأْسَاءُ"]},{"n":340,"s":["غَيْرَ أَنِّي فَوَّضْتُ أَمْرِي إِلَى الل","هِ وَتَفْوِيضِيَ الأُمُورَ بَرَاءُ"]},{"n":341,"s":["رُبَّ يَوْمٍ بِكَرْبَلاَءَ مُسِيءٍ","خَفَّفَتْ بَعْضَ وِزْرِهِ الزَّوْرَاءُ"]},{"n":342,"s":["وَالأَعَادِي كَأَنَّ كُلَّ طَرِيحٍ","مِنْهُمُ الزِّقُّ حُلَّ عَنْهُ الْوِكَاءُ"]},{"n":343,"s":["آلَ بَيْتِ النَّبِيِّ طِبْتُمْ فَطَابَ الْ","مَدْحُ لِي فِيكُمُ وَطَابَ الرِّثَاءُ"]},{"n":344,"s":["أَنَا حَسَّانُ مَدْحِكُمْ فَإِذَا نُحْ","تُ عَلَيْكُمْ فَإِنَّنِي الْخَنْسَاءُ"]},{"n":345,"s":["سُدْتُمُ النَّاسَ بِالتُّقَى وَسِوَاكُمْ","سَوَّدَتْهُ الْبَيْضَاءُ والصَّفْرَاءُ"]},{"n":346,"s":["وَبِأَصْحَابِكَ الذِينَ هُمُ بَعْ","دَكَ فِينَا الهُدَاةُ وَالأَوْصِيَاءُ"]},{"n":347,"s":["أَحْسَنُوا بَعْدَكَ الْخِلاَفَةَ فِي الدِّي","نِ وَكُلٌّ لِمَا تَوَلَّى إِزَاءُ"]},{"n":348,"s":["أَغْنِيَاءٌ نَزَاهَةً فُقَرَاءُ","عُلَمَاءٌ أَيِمَّةٌ أُمَراءُ"]},{"n":349,"s":["زَهِدُوا فِي الدُّنَا فَمَا عُرِفَ الْمَيْ","لُ إِلَيْهَا مِنْهُمْ وَلاَ الرَّغْبَاءُ"]},{"n":350,"s":["أَرْخَصُوا فِي الْوَغَى نُفُوسَ مُلُوكٍ","حَارَبُوهَا أَسْلاَبُهَا إِغْلاَءُ"]},{"n":351,"s":["كُلُّهُمْ فِي أَحْكَامِهِ ذُو اجْتِهَادٍ","وَصَوَابٍ وَكُلُّهُمْ أَكْفَاءُ"]},{"n":352,"s":["رَضِيَ اللهُ عَنْهُمْ وَرَضُوا عَنْ","هُ فَأَنَّى يَخْطُو إِلَيْهِمْ خَطَاءُ"]},{"n":353,"s":["جَاءَ قَوْمٌ مِنْ بَعْدِ قَوْمٍ بِحَقٍّ","وَعَلَى الْمَنْهَجِ الْحَنِيفِيِّ جَاءُوا"]},{"n":354,"s":["مَا لِمُوسَى وَلاَ لِعِيسَى حَوَارِ","يُّونَ فِي عَدِّهِمْ وَلاَ نُقَبَاءُ"]},{"n":355,"s":["بِأَبِي بَكْرٍ الذِي صَحَّ لِلنَّا","سِ بِهِ فِي حَيَاتِكَ الإِقْتِدَاءُ"]},{"n":356,"s":["وَالْمُهَدِّي يَوْمَ السَّقِيفَةِ لَمَّا","أَرْجَفَ النَّاسُ إِنَّهُ الدَّأْدَاءُ"]},{"n":357,"s":["أَنْقَذَ الدِّينَ بَعْدَ مَا كَانَ لِلدِّي","نِ عَلَى كُلِّ كُرْبَةٍ إِشْفَاءُ"]},{"n":358,"s":["أَنْفَقَ الْمَالَ فِي رِضَاكَ وَلاَ مَ","نٌ وَأَعْطَى جَمّاً وَلاَ إِكْدَاءُ"]},{"n":359,"s":["وَأَبِي حَفْصٍ الذِي أَظْهَرَ اللَّ","هُ بِهِ الدِّينَ فَارْعَوَى الرُّقَبَاءُ"]},{"n":360,"s":["والذِي تَقْرُبُ الأَبَاعِدُ فِي الل","هِ إِلَيْهِ وَتَبْعُدُ الْقُرَبَاءُ"]},{"n":361,"s":["عُمَرَ بْنِ الْخَطَّابِ مَنْ قَوْلُهُ الْفَصْ","لُ وَمَنْ حُكْمُهُ السَّوِيُّ السَّواءُ"]},{"n":362,"s":["فَرَّ مِنْهُ الشَّيْطَانُ إِذْ كَانَ فَارُو","قاً فَلِلنَّارِ مِنْ سَنَاهُ انْبِرَاءُ"]},{"n":363,"s":["وَابْنِ عَفَّانَ ذِي الأَيَادِي التِي طَا","لَ إِلَى الْمُصْطَفَى بِهَا الإِسْدَاءُ"]},{"n":364,"s":["حَفَرَ الْبِئْرَ جَهَّزَ الْجَيْشَ أَهْدَى","الْهَدْيَ لَمَّا أَنْ صَدَّهُ الأَعْدَاءُ"]},{"n":365,"s":["وَأَبَى أَنْ يَطُوفَ بِالْبَيْتِ إِذْ لَمْ","يَدْنُ مِنْهُ إِلَى النَّبِيِّ فِنَاءُ"]},{"n":366,"s":["فَجَزَتْهُ عَنْهَا بِبَيْعَةِ رِضْوَا","نٍ يَدٌ مِنْ نَبِيِّهِ بَيْضَاءُ"]},{"n":367,"s":["أَدَبٌ عِنْدَهُ تَضَاعَفَتِ الأَعْ","مَالُ بِالتَّرْكِ حَبَّذَا الأُدَبَاءُ"]},{"n":368,"s":["وَعَلِيٍّ صِنْوِ النَّبِيِّ وَمَنْ دِي","نُ فُؤَادِي وِدَادُهُ وَالْوَلاَءُ"]},{"n":369,"s":["وَوَزِيرِ ابْنِ عَمِّهِ فِي الْمَعَالِي","وَمِنَ الأَهْلِ تَسْعَدُ الْوُزَرَاءُ"]},{"n":370,"s":["لَمْ يَزِدْهُ كَشْفُ الْغِطَاءِ يَقِيناً","بَلْ هُوَ الشَّمْسُ مَا عَلَيْهِ غِطَاءُ"]},{"n":371,"s":["وَبِبَاقِي أَصْحَابِكَ الْمُظْهِرِ التَّرْ","تِيبَ فِينَا تَفْضِيلُهُمْ وَالْوَلَاءُ"]},{"n":372,"s":["طَلْحَةَ الْخَيْرِ الْمُرْتَضِيهِ رَفِيقاً","وَاحِداً يَوْمَ فَرَّتِ الرُّفَقَاءُ"]},{"n":373,"s":["وَحَوَارِيِّكَ الزُّبَيْرِ أَبِي الْقَرْ","مِ الذِي أَنْجَبَتْ بِهِ أَسْمَاءُ"]},{"n":374,"s":["وَالصَّفِيَّيْنِ تَوْأَمِ الْفَضْلِ سَعْدٍ","وَسَعِيدٍ إِنْ عُدَّتِ الأَصْفِيَاءُ"]},{"n":375,"s":["وَابْنِ عَوْفٍ مَنْ هَوَّنَتْ نَفْسُهُ الدُّنْ","يَا بِبَذْلٍ يُمِدُّهُ إِثْرَاءُ"]},{"n":376,"s":["وَالْمُكَنَّى أَبَا عُبَيْدَةَ إِذْ يَعْ","زِي إِلَيْهِ الأَمَانَةَ الأُمَنَاءُ"]},{"n":377,"s":["وَبِعَمَّيْكَ نَيِّرَيْ فَلَكِ الْمَجْ","دِ وَكُلٌّ أَتَاهُ مِنْكَ إِتَاءُ"]},{"n":378,"s":["وَبِأُمِّ السِّبْطَيْنِ زَوْجِ عَلِيٍّ","وَبَنِيهَا وَمَنْ حَوَتْهُ الْعَبَاءُ"]},{"n":379,"s":["وَبِأَزْوَاجِكَ اللَّوَاتِي تَشَرَّفْ","نَ بِأَنْ صَانَهُنَّ مِنْكَ بِنَاءُ"]},{"n":380,"s":["الأَمَانَ الأَمَانَ إِنَّ فُؤَادِي","مِنْ ذُنُوبٍ أَتَيْتُهُنَّ هَوَاءُ"]},{"n":381,"s":["قَدْ تَمَسَّكْتُ مِنْ وِدَادِكَ بِالْحَبْ","لِ الذِي اسْتَمْسَكَتْ بِهِ الشُّفَعَاءُ"]},{"n":382,"s":["وَأَبَى اللهُ أَنْ يَمَسَّنِيَ السُّو","ءُ بِحَالٍ وَلِي إِلَيْكَ الْتِجَاءُ"]},{"n":383,"s":["قَدْ رَجَوْنَاكَ لِلأُمُورِ التِي أَبْ","رَدُهَا فِي فُؤَادِنَا رَمْضَاءُ"]},{"n":384,"s":["وَأَتَيْنَا إِلَيْكَ أَنْضَاءَ فَقْرٍ","حَمَلَتْنَا إِلَى الْغِنَا أَنْضَاءُ"]},{"n":385,"s":["وَانْطَوَتْ فِي الصُّدُورِ حَاجَاتُ نَفْسٍ","مَا لَهَا عَنْ نَدَى يَدَيْكَ انْطِوَاءُ"]},{"n":386,"s":["فَأَغِثْنَا يَا مَنْ هُوَ الْغَوْثُ وَالْغَيْ","ثُ إِذَا أَجْهَدَ الْوَرَى اللَّأْوَاءُ"]},{"n":387,"s":["وَالْجَوَادُ الذِي بِهِ تُفْرَجُ الْغُ","مَّةُ عَنَّا وَتُكْشَفُ الْحَوْبَاءُ"]},{"n":388,"s":["يَا رَحِيماً بِالْمُؤْمِنِينَ إِذَا مَا","ذَهِلَتْ عَنْ أَبْنَائِهَا الرُّحَمَاءُ"]},{"n":389,"s":["يَا شَفِيعاً فِي الْمُذْنِبِينَ إِذَا أَشْ","فَقَ مِنْ خَوفِ ذَنْبِهِ الْبُرَآءُ"]},{"n":390,"s":["جُدْ لِعَاصٍ وَمَا سِوَايَ هُوَ الْعَا","صِي وَلَكِنْ تَنْكِيرِيَ اسْتِحْيَاءُ"]},{"n":391,"s":["وَتَدَارَكْهُ بِالْعِنَايَةِ مَا دَا","مَ لَهُ بِالذِّمَامِ مِنْكَ ذِمَاءُ"]},{"n":392,"s":["أَخَّرَتْهُ الأَعْمَالُ وَالْمَالُ عَمَّا","قَدَّمَ الصَّالِحُونَ وَالأَغْنِيَاءُ"]},{"n":393,"s":["كُلَّ يَوْمٍ ذُنُوبُهُ صَاعِدَاتٌ","وَعَلَيْهَا أَنْفَاسُهُ صُعَدَاءُ"]},{"n":394,"s":["أَلِفَ الْبِطْنَةَ الْمُبَطِّئَةَ السَّيْ","رِ بِدَارٍ بِهَا الْبِطَانُ بِطَاءُ"]},{"n":395,"s":["فَبَكَى ذَنْبَهُ بِقَسْوَةِ قَلْبٍ","نَهَتِ الدَّمْعَ فَالْبُكَاءُ مُكَاءُ"]},{"n":396,"s":["وَغَدَا يَعْتِبُ الْقَضَاءَ وَلاَ عُذْ","رَ لِعَاصٍ فِيمَا يَسُوقُ الْقَضَاءُ"]},{"n":397,"s":["أَوْثَقَتْهُ مِنَ الذُّنُوبِ دُيُونٌ","شَدَّدَتْ فِي اقْتِضَائِهَا الْغُرَمَاءُ"]},{"n":398,"s":["مَا لَهُ حِيلَةٌ سِوَى حِيلَةِ الْمُو","ثَقِ إِمَّا تَوَسُّلٌ أَوْ دُعَاءُ"]},{"n":399,"s":["رَاجِياً أَنْ تَعُودَ أَعْمَالُهُ السُّو","ءُ بِغُفْرَانِ اللهِ وَهْيَ هَبَاءُ"]},{"n":400,"s":["أَوْ تُرَى سَيِّئَاتُهُ حَسَنَاتٍ","فَيُقَالُ اسْتَحَالَتِ الصَّهْبَاءُ"]},{"n":401,"s":["كُلُّ أَمْرٍ تُعْنَى بِهِ تُقْلَبُ الأَعْ","يَانُ فِيهِ وَتَعْجَبُ الْبُصَرَاءُ"]},{"n":402,"s":["رُبَّ عَيْنٍ تَفَلْتَ فِي مَاءِهَا الْمِلْ","حِ فَأَضْحَى وَهْوَ الْفُرَاتُ الرَّوَاءُ"]},{"n":403,"s":["آهِ مِمَّا جَنَيْتُ إِنْ كَانَ يُغْنِي","أَلِفٌ مِنْ عَظِيمِ ذَنْبٍ وَهَاءُ"]},{"n":404,"s":["أَرْتَجِي التَّوْبَةَ النَّصُوحَ وَفِي الْقَلْ","بِ نِفَاقٌ وَفِي اللِّسَانِ رِيَاءُ"]},{"n":405,"s":["وَمَتَى يَسْتَقِيمُ قَلْبِي وَلِلْجِسْ","مِ اعْوِجَاجٌ مِنْ كِبْرَتِي وَانْحِنَاءُ"]},{"n":406,"s":["كُنْتُ فِي نَوْمَةِ الشَّبَابِ فَمَا اسْتَيْ","قَظْتُ إِلاَّ وَلِمَّتِي شَمْطَاءُ"]},{"n":407,"s":["وَتَمَادَيْتُ أَقْتَفِي أَثَرَ الْقَوْ","مِ فَطَالَتْ مَسَافَةٌ وَاقْتِفَاءُ"]},{"n":408,"s":["فَوَرَا السَّائِرِينَ وَهْوَ أَمَامِي","سُبُلٌ وَعْرَةٌ وَأَرْضٌ عَرَاءُ"]},{"n":409,"s":["حَمِدَ الْمُدْلِجُونَ غِبَّ سُرَاهُمْ","وَكَفَى مَنْ تَخَلَّفَ الإِبْطَاءُ"]},{"n":410,"s":["رِحْلَةٌ لَمْ يَزَلْ يُفَنِّدُنِي الصَّيْ","فُ إِذَا مَا نَوَيْتُهَا وَالشِّتَاءُ"]},{"n":411,"s":["يَتَّقِي حُرُّ وَجْهِيَ الْحَرَّ والْبَرْ","دَ وَقَدْ عَزَّ مِنْ لَظَى الإِتِّقَاءُ"]},{"n":412,"s":["ضِقْتُ ذَرْعاً مِمَّا جَنَيْتُ فَيَوْمِي","قَمْطَرِيرٌ وَلَيْلَتِي دَرْعَاءُ"]},{"n":413,"s":["وَتَذَكَّرْتُ رَحْمَةَ اللهِ فَالْبِشْ","رُ لِوَجْهِي أَنَّى انْتَحَى تِلْقَاءُ"]},{"n":414,"s":["فَأَلَحَّ الرَّجَاءُ وَالْخَوْفُ بِالْقَلْ","بِ وَلِلْخَوْفِ وَالرَّجَا إِحْفَاءُ"]},{"n":415,"s":["صَاحِ لاَ تَأْسَ إِنْ ضَعُفْتَ عَنِ الطَّا","عَةِ وَاسْتَأْثَرَتْ بِهَا الأَقْوِيَاءُ"]},{"n":416,"s":["إِنَّ للهِ رَحْمَةً وَأَحَقُّ","النَّاسِ مِنْهُ بِالرَّحْمَةِ الضُّعَفَاءُ"]},{"n":417,"s":["فَابْقَ فِي الْعُرْجِ عِنْدَ مُنْقَلَبِ الذَّوْ","دِ فَفِي الْعَوْدِ تَسْبِقُ الْعَرْجَاءُ"]},{"n":418,"s":["لاَ تَقُلْ حَاسِداً لِغَيْرِكَ هَذَا","أَثْمَرَتْ نَخْلُهُ وَنَخْلِي عَفَاءُ"]},{"n":419,"s":["وَأَتِ بِالْمُسْتَطَاعِ مِنْ عَمَلِ الْبِ","رِّ فَقَدْ يُسْقِطُ الثِّمَارَ الإِتَاءُ"]},{"n":420,"s":["وَبِحُبِّ النَّبِيِّ فَابْغِ رِضَا اللَّ","هِ فَفِي حُبِّهِ الرِّضَا وَالْحِبَاءُ"]},{"n":421,"s":["يَا نَبِيَّ الْهُدَى اسْتِغَاثَةَ مَلْهُو","فٍ أَضَرَّتْ بِحَالِهِ الْحَوْبَاءُ"]},{"n":422,"s":["يَدَّعِي الْحُبَّ وَهْوَ يَأْمُرُ بِالسُّو","ءِ وَمَنْ لِي أَنْ تَصْدُقَ الرَّغْبَاءُ"]},{"n":423,"s":["أَيُّ حُبٍّ يَصِحُّ مِنْهُ وَطَرْفِي","لِلْكَرَى وَاصِلٌ وَطَيْفُكَ رَاءُ"]},{"n":424,"s":["لَيْتَ شِعْرِي أَذَاكَ مِنْ عُظْمِ ذَنْبٍ","أَمْ حُظُوظُ الْمُتَيَّمِينَ حُظَاءُ"]},{"n":425,"s":["إِنْ يَكُنْ عُظْمُ زَلَّتِي حُجْبَ رُؤْيَا","كَ فَقَدْ عَزَّ دَاءَ قَلْبِي الدَّوَاءُ"]},{"n":426,"s":["كَيْفَ يَصْدَا بِالذَّنْبِ قَلْبُ مُحِبٍّ","وَلَهُ ذِكْرُكَ الْجَمِيلُ جِلاَءُ"]},{"n":427,"s":["هَذِهِ عِلَّتِي وَأَنْتَ طَبِيبِي","لَيْسَ يَخْفَى عَلَيْكَ فِي الْقَلْبِ دَاءُ"]},{"n":428,"s":["وَمِنَ الْفَوْزِ أَنْ أَبُثَّكَ شَكْوَى","هِيَ شَكْوَى إِلَيْكَ وَهْيَ اقْتِضَاءُ"]},{"n":429,"s":["ضُمِّنَتْهَا مَدَائِحٌ مُسْتَطَابٌ","فِيكَ مِنْهَا الْمَدِيحُ وَالإِصْغَاءُ"]},{"n":430,"s":["قَلَّمَا حَاوَلَتْ مَدِيحَكَ إِلاَّ","سَاعَدَتْهَا مِيمٌ وَدَالٌ وَحَاءُ"]},{"n":431,"s":["حَقَّ لِي فِيكَ أَنْ أُسَاجِلَ قَوْماً","سَلَّمَتْ مِنْهُمُ لِدَلْوِي الدِّلاَءُ"]},{"n":432,"s":["إِنَّ لِي غَيْرَةً وَقَدْ زَاحَمَتْنِي","فِي مَعَانِي مَدِيحِكَ الشُّعَرَاءُ"]},{"n":433,"s":["وَلِقَلْبِي فِيكَ الْغُلُوُّ وَأَنَّى","لِلِسَانِي فِي مَدْحِكَ الْغُلَوَاءُ"]},{"n":434,"s":["فَأَثِبْ خَاطِراً يَلَذُّ لَهُ مَدْ","حُكَ عِلْماً بِأَنَّهُ اللَّأْلاَءُ"]},{"n":435,"s":["حَاكَ مِنْ صَنْعَةِ الْقَرِيضِ بُرُوداً","لَكَ لَمْ تَحْكِ وَشْيَهَا صَنْعَاءُ"]},{"n":436,"s":["أَعْجَزَ الدُّرَّ نَظْمُهُ فَاسْتَوَتْ فِي","هِ الْيَدَانِ الصَّنَّاعُ وَالْخَرْقَاءُ"]},{"n":437,"s":["فَارْضَهُ أَفْصَحَ امْرِئٍ نَطَقَ الضَّا","دَ فَقَامَتْ تَغَارُ مِنْهَا الظَّاءُ"]},{"n":438,"s":["أَبِذِكْرِ الآيَاتِ أُوفِيكَ مَدْحاً","أَيْنَ مِنِّي وَأَيْنَ مِنْهَا الْوَفَاءُ"]},{"n":439,"s":["أَمْ أُمَارِي بِهِنَّ قَوْمَ نَبِيٍّ","سَاءَ مَا ظَنَّهُ بِيَ الأَغْبِيَاءُ"]},{"n":440,"s":["وَلَكَ الأُمَّةُ التِي غَبَطَتْهَا","بِكَ لَمّا أَتَيْتَهَا الأَنْبِيَاءُ"]},{"n":441,"s":["لَمْ تَخَفْ بَعْدَكَ الضَّلاَلَ وَفِينَا","وَارِثُو نُورِ هَدْيِكَ الْعُلَمَاءُ"]},{"n":442,"s":["فَانْقَضَتْ آيُ الأَنْبِيَاءِ وَآيَا","تُكَ فِي النَّاسِ مَا لَهُنَّ انْقِضَاءُ"]},{"n":443,"s":["وَالْكَرَامَاتُ مِنْهُمُ مُعْجِزَاتٌ","حَازَهَا مِنْ نَوَالِكَ الْأَوْلِيَاءُ"]},{"n":444,"s":["إِنَّ مِنْ مُعْجِزَاتِكَ الْعَجْزَ عَنْ وَصْ","فِكَ إِذْ لاَ يَحُدُّهُ الإِحْصَاءُ"]},{"n":445,"s":["كَيْفَ يَسْتَوْعِبُ الْكَلاَمُ سَجَايَا","كَ وَهَلْ تَنْزِحُ الْبِحَارَ الرِّكَاءُ"]},{"n":446,"s":["لَيْسَ مِنْ غَايَةٍ لِوَصْفِكَ أَبْغِي","هَا وَلِلْقَوْلِ غَايَةٌ وَانْتِهَاءُ"]},{"n":447,"s":["إِنَّمَا فَضْلُكَ الزَّمَانُ وَآيَا","تُكَ فِيمَا نَعُدُّهُ الآنَاءُ"]},{"n":448,"s":["لَمْ أُطِلْ فِي تَعْدَادِ مَدْحِكَ نُطْقِي","وَمُرَادِي بِذَلِكَ اسْتِقْصَاءُ"]},{"n":449,"s":["غَيْرَ أَنِّي ظَمْآنُ وَجْدٍ وَمَا لِي","بِقَلِيلٍ مِنَ الْوُرُودِ ارْتِوَاءُ"]},{"n":450,"s":["فَسَلاَمٌ عَلَيْكَ تَتْرَى مِنَ اللَّ","هِ وَتَبْقَى بِهِ لَكَ الْبَأْوَاءُ"]},{"n":451,"s":["وَسَلاَمٌ عَلَيْكَ مِنْكَ فَمَا غَيْ","رُكَ مِنْهُ لَكَ السّلاَمُ كِفَاءُ"]},{"n":452,"s":["وَسَلاَمٌ مِنْ كُلِّ مَا خَلَقَ اللَّ","هُ لِتَحْيَا بِذِكْرِكَ الأَمْلاَءُ"]},{"n":453,"s":["وَصَلاَةٌ كَالْمِسْكِ تَحْمِلُهُ مِ","نِّي شَمَالٌ إِلَيْكَ أَوْ نَكْبَاءُ"]},{"n":454,"s":["وَسَلاَمٌ عَلَى ضَرِيحِكَ تَخْضَ","لُّ بِهِ مِنْهُ تُرْبَةٌ وَعْسَاءُ"]},{"n":455,"s":["وَثَنَاءٌ قَدَّمْتُ بَيْنَ يَدَيْ نَجْ","وَايَ إِذْ لَمْ يَكُنْ لَدَيَّ ثَرَاءُ"]},{"n":456,"s":["مَا أَقَامَ الصَّلَاةَ مَنْ عَبَدَ اللَّ","هَ وَقَامَتْ بِرَبِّهَا الْأَشْيَاءُ"]}],"contentVersion":1,"coverThumb":"data/books/hamziyya/images/cover.webp?v=7c0629825e","chapterNote":"عناوين الفصول من طبعة «أم القرى في مدح خير الورى» بتحقيق الشيخ محمد الشاذلي النيفر، وليست من وضع الناظم.","refrain":{"verses":[["صَلِّ يَا رَبِّ ثُمَّ سَلِّمْ عَلَى مَنْ","هُوَ لِلْخَلْقِ رَحْمَةٌ وَشِفَاءُ"],["وَعَلَى الْآلِ وَالصَّحَابَةِ جَمْعًا","مَا تَزَيَّنَتْ بِالنُّجُومِ السَّمَاءُ"]]},"sheikhs":[],"sections":[],"order":[]}