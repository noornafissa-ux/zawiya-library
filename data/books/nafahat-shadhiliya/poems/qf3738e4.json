{"id":"qf3738e4","title":"شُورْ الحبِيبْ قَلبيْ لَبّى","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["هلْ يا دَرَى المَوْلىَ يَجْعَل لي شي نَصِيبْ","يا مَن دَرَى نْبَاشِرْ قُبَّا"],["طِيبَة وطِيبَة طابت جمعت كُلّ طِيبْ","يَكْفِيك ما حَوَت القُبّة"],["نْبَاشِر المْقَام بْرِقّة مَانِي أْدِيبْ","وَجهي نعَفْرُو في التربة"],["نَجْلِس كالمُيَتَّمْ حَذوِ الجَنْبِ القْرِيبْ","بِدْمُوعْ هَاطْلَة مَسْكُوبة"],["نَبْقَى مْلازْمُو مْتذلّل عابد النّحِيبْ","مُحال مانَعْجّلْ أُوبَة"],["داري ودار بُويا نمكُث ماني غْريبْ","مَنسُوب لَه حقّ النِسبَة"],["هذا المقام ما نَجْهْلو","قدرو مشـرّف على القِبلة"],["إذا بْغِيت تعرف فَضلُو","تَجْمَع مِنَ الخِصايل جُملة"],["ما رَيْتْ في المْسَاكْن مِثلو","فاقَ الجميعْ حُسنْ وَصوْلَة"],["فوْق السحابْ قَدرو يَعلو","يشَابِه السما في النّزلة"],["الشمسْ والقمرْ يَذْهلو","لَو كان سَاكْنُو يَتْجَلّى"],["الأملاك حَافّة من حَوْلُو","وأنوار خَارْقَة لِلعُلا"]],"widths":[4241,4303],"gaps":[1083]},{"cols":1,"rows":[["نحكي شمايل المُصطفى"]],"widths":[4106],"gaps":[]},{"cols":2,"rows":[["مْفَخَّمْ المفاصلْ قَوي جِسْمُو نْضيفْ","أبْهَـــــى مـن القمر في الصّفا"],["لِحية مجمَّمة مكحولة شَعْرو كثيف","البياض في السواد اختفى"],["موفَّر الشعر مُجعَّد فاني رهيفْ","مَفروقْ جات فيه ظرافة"],["مفجَّجْ الثنايا يلمع ريقو لطيفْ","ضَلعُ الفم حمـــــــرُ الــــــشّفّة"],["مْوَسَّعْ الصّدرْ والمنكبْ ماذا نْصِيفْ","في القـدّ والبدن والوقْفَـــــــــة"],["البطشْ والشجاعه نحكي ريحاً عصيفْ","يخطو في مَشْيَتُو يتكفَّا"],["داري ودار بُويا نمكُث ماني غْريبْ","مَنسُوب لَه حقّ النِسبَة"],["إذا بغيت تعرف بَدْنُو","تَجْمَعْ من الأوصاف الحسنى"],["مـشروبْ بالحمُورة لُونو","مَربُــــــــــوع قــامتو يَتْكَنّى"],["شثن الكَفّ فيهِ لَيْنُ","مخَضَّب الشّعر بالحَنَّا"],["سِتّينْ جَازْهَا في سِنُّو","بالسّنِينْ سَنَتَيْن وسَنَة"],["ما كَلّ ما نْقَصْ من حُسنو","سبحان من أهــــداه السّنا"],["حَتَّى صْفَت ودخَل كفْنو","لا نْقَص صَادْفُو لا هَانَه"]],"widths":[4241,4303],"gaps":[1083]},{"cols":1,"rows":[["منسُوم في الصّغر تربَّى"]],"widths":[4061],"gaps":[]},{"cols":2,"rows":[["مهذَّب الأخلاق مْحدّق صبي لبيبْ","مشَـرَّف القدر والنِسبة"],["مخالف الأعدا من صُغرو ضد الصَّليبْ","مَهيوب في أهلو والقُربى"],["معدّل القوايم صافي بَدْنُو خْصِيبْ","يْحيِّر النّظر في الوَجبة"],["ما رِيت في الخلايق مثلُو طبعو قريبْ","في اللّين معتدل والهيبة"],["لو كان ننتبه لاخلاقو كُثرة نصيبْ","نعجز في مدَاد الكتبة"],["في الثّوب ما يْخَيّر يتْسَتّر كِي يْصِيبْ","في الشدّ لازْمَتَه عَذبة"],["داري ودار بُويا نمكُث ماني غْريبْ","مَنسُوب لَه حقّ النِسبَة"],["إذا بغيت تعرف بَصْـرُو","أدعج العيونْ فيه سْموُرَة"],["مهذَّب الشَفْر خافضْ نظرو","طرف السّواد فيه حْمُورَة"],["مزجَّج الحواجبْ ظهـــــــرو","نُونَيْن في الورق مسطورة"],["أقنا الأنفْ شاهِرْ خبرُو","معلوم في المُدن والقُرى"],["رَحْـب الجَبينْ عِنــــدي عَـــبْرُو","مكمول في الحُسن والصّورة"],["متّصل للبطنْ بْصدرو","مشعُور لَبْتّو للسّـرّة"]],"widths":[4241,4303],"gaps":[1083]},{"cols":1,"rows":[["في ذا الحديث عِندي رَغبَة"]],"widths":[4016],"gaps":[]},{"cols":2,"rows":[["إذا ذكرت طه نخشـى عقلي يغيبْ","مجذوب فيه حقّ الجذبة"],["راني نقول نصِل قبْرو ماشي صْعيبْ","مهمـا تكـون لي وجبة"],["معلوم من تألّم يتحوَّج للطبيبْ","ويكابِدْ الطّرِيق الـصّعبة"],["والعاشق المِيَتَّم يتقرّب كي يصيبْ","الصّدق شـرط في المحبّة"],["ربّي لابن عليوة تجعل فتحًا قريبْ","ويحوز في المعالي رُتبة"],["بأهلي وإخوتي ننتقل شُورَ الحبيبْ","في كفالةِ النّبي نتربَّـى"]],"widths":[4241,4303],"gaps":[1083]}],"source":{"pdfPage":25,"printedNumber":16,"tocTitle":"شُورْ الحبِيبْ قَلبيْ لَبّى"},"n":16,"section":"muhammadiya","sectionTitle":"القصائد المحمدية","recordings":[]}