{"id":"qd8532e4","title":"اللّه يَا نُورَ النُّورْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["الله يَا نُورَ النُّورْ","مِنْكَ كُلُّ الأَنْوَارْ"],["بَطَنْتَ فِي الظُّهُورْ","وَغِبْتَ فِي الأَبْصَارْ"],["وصَاحِبُ الشّعُورْ","فِي جَمَالِكَ حَارْ"],["ظَهَرْتَ بِأَلْوَانْ","لَا تُحْصَـى بِالتّعْدَادْ"],["وَكُلُّ لَوْنٍ كَانْ","كَامِلَ الاِسْتِعْدَادْ"],["نَرَاكَ بِالعِيَانْ","ظَاهِرًا فِي العِبَادْ"],["كُلُّ الخَلْقِ تِبْيَانْ","لِسِـرِّكَ المَصُونْ"],["وَالظّرْفُ والزَّمَانْ","أَمَرْتَهُ يَكُونْ"],["مِنْ نُورِكَ المُصَانْ","وَسِـرِّكَ المَخْزُونْ"],["مِنْ حَضْـرَةِ القُدُّوسْ","تَجَلَّتِ الكِيسَانْ"],["كَالزَهْرِ فِي الغُرُوسْ","وَالوَرْد فِي الجِنَانْ"],["فكُلّـهَا كُؤُوسْ","أَنَا بِهَا نَشْوَانْ"],["مُشْـرِقَةُ الجَمَالْ","تُضِـي مِثْلَ السّـرَاجْ"],["قَلْبِي لَهَا قَدْ مَالْ","مِنْ حُسْنِهَا الوَهَّاجْ"],["لَيْسَ لَهَا مِثالْ","فِي وَصْفِهَا البَهَّاجْ"],["بَدَا فِيهَا المَحْبُوبْ","فِي حُلَّةِ العَرُوسْ"],["حُزْنَا مِنْهَا المَرْغُوبْ","إِذْ أَشْرَقَتْ شُمُوسْ"],["مِنْ عَالَمِ الغُيُوبْ","فَأَحَيَتِ النُّفُوسْ"],["الأَرْضُ وَالسَّمَا","نُورُ الحَقِّ المُبِينْ"],["وَالخَلْقُ فِيهِمَا","تَجَلِّي عَيْنِ العَيْنْ"],["إِن كُنْتَ فَاهِمًا","فَاسْمَعْ مِنِّي اليَقِينْ"],["يَا فَاهِمَ الكَلَامْ","كُلُّ الخَلْقِ رُمُوزْ"],["وَالحَازِمُ الهُمَامْ","هُوَ الذِّي يَحُوزْ"],["مِنْ خَمْرَةِ المُدَامْ","كَأسًا بِهَا يَفُوزْ"],["تُمْحَى بِهَا الأَغْيَارْ","مِنْ لَوْحَةِ الوُجُودْ"],["فَتُبْصِـرُ الأَطْوَارْ","مِرآةٌ لِلْمَعْبُودْ"],["الوَاحِد القَهَّارْ","جَمِيلٌ فِي الشُّهُودْ"],["صَلُوا عَلَى ذِي التَّاجْ","الصَّادِق الآَمِينْ"],["مَنْ جَاءَ بِالمِنْهَاجْ","رَسُولِ الثَّقَلَيْنْ"],["وَالمَدَانِي المُحْتَاجْ","يَرْجُو خَيَرَ الدّارَيْنْ"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":101,"printedNumber":6,"tocTitle":"اللّه يَا نُورَ النُّورْ"},"n":7,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}