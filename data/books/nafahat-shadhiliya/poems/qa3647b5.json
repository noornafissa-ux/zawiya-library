{"id":"qa3647b5","title":"للّهِ دُرّك يا إمَـامُ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["لله دَرُّك يا إمامُ لقد غَدَا","من الثّرَى إلى الثّرَيَا سِرُّك لامِعُ"],["فأنتَ إمامُ الوقتِ لا شكَّ والذّي","يُخالفُ هذا فَحسُودٌ مُنَازعُ"],["فَكَم أيقظتَ مِن قلوبٍ تَغافَلَت","فقامت إلى الخيراتِ عَزْمًا تُسَارِعُ"],["وكم رفعتَ للشُّهود من صادقٍ","فزالَ عنهُ حِجَابُهُ المَانِعُ"],["فإن نظرتَ إلى المُريدِ أغْنَيْتَهُ","وإن نطَقتَ تَنفي الأكوانَ وتَجْمَعُ"]],"widths":[4270,4337],"gaps":[1016]}],"source":{"pdfPage":186,"printedNumber":null,"tocTitle":"لله درّكَ يا إمامُ"},"n":null,"section":"unsectioned","sectionTitle":null,"recordings":[]}