{"id":"q1edbd81","title":"يَا مَنْ لمْ تَفهَم مَقَالِي","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يَا مَنْ لم تَفهَم مَقَالِي","لِمَاذَا تُنْكِر عَلَيّا"],["أنتَ مِنَ المعنى خالِ","جاهِلًا بالألوهيّا"],["لو كنتَ تعلَمْ بحالي","تعترِف لي بالمزيّا"],["تَراني بينَ الرّجالِ","كشَمسٍ على بريّا"],["أعطاني ربّي سُؤالي","كَفاني مَوْلَى الهدِيّا"],["هَداني ثُمَّ هَدَى لي","حُلَّةً منهُ مَرضيّا"],["سَقاني مِن كَأسٍ غَالِ","أَعزُّ مِنَ الكَيميّا"],["رفَعني مقعَدًا عَالِ","أعلى من نجمِ الثُريّا"],["إن طلبتني يا وَلِي","فاسأل عنّي الرّبوبيّا"],["انظُرني فوقَ المَعَالي","عَساكَ تعثُرْ عليّا"],["لا تَطلبني في الأبدالِ","ولا مِن عند الصوفيّة"],["ولا من أهلِ الكُمَّال","ولا عِندَ الرُّوحَانيّا"],["أنا جنسٌ عالٍ غالِ","أمرٌ غَيبٌ لا كيفيّا"],["فقد وُجِد كنزُ مالي","كلُّ شيءٍ غابَ فيّا"],["إيش تعرف في أحوالي","يا جاهلَ الخصوصيّا"],["أنت تحسَب أنّي خَالي","حسبُكَ عقدَك والنيّا"],["إذا المحبوبُ كَانَ لي","لا نلتَفِت إلى الدّنيا"],["فماذا تقضـي عُذّالي","حَيثُ تَعتَرض عَليّا"],["القلبُ منّي يبقى لي","والحسُّ لهم هديّا"],["والوقتُ إذا يصفى لي","لا نَعتبِر البليّا"],["كلّ عَارف بهِ سَالي","على جَميعِ البريّا"],["ومطموسُ القلبِ الخالي","لا يرى إلّا الفانيّا"],["يُلقي نفسَه في ضلالٍ","ليجمَع شيئاً في الدنيا"],["لا يلتَفت لآجالٍ","ولا لقربِ المنيّا"],["لا يُصاحبُ الكُمَّالِ","لا يعدو عن المعصيّا"],["مقيماً على جِدالٍ","محارِبْ لِلألُوهيّا"],["ربّي يَقبَل لي سُؤَالي","تَوبَةً منهُ مَرضيّا"],["تحمينا في كلِّ حَالٍ","والأمّة المُحمّديّا"],["ثمّ من فيضِ الجمالِ","صلاةُ اللَهِ باقيّا"],["ما صلّى عابدْ ووَلِي","على أشـرفِ الأنبيَا"],["وكلّ صَحبٍ وآلٍ","والأسنادِ أهلِ التربيّا"],["ومن صالحٍ وولِي","يشمَلهُم نورُ التحِيّا"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":85,"printedNumber":49,"tocTitle":"يَا مَنْ لمْ تَفهَم مَقَالِي"},"n":49,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[]}