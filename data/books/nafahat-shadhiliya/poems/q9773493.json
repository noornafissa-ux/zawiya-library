{"id":"q9773493","title":"يا سُقَـاةَ الـرَّاحِ قُومُـوا","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يا سُقـاةَ الرَّاحِ قُومُـوا","بِنا للحُسْنِ الفتَّانْ"],["في حَضـرةِ القُدْسِ هِيـمُـوا","وتِيهُوا عنِ الأكوانْ"],["إنّنِـي الصَّبُّ الـغَـريمُ","مرتهِنٌ في هذا الشأنْ"],["وأمـري فــيــهِ عـظـيـمُ","خــارجٌ عن الإمـــكـــانْ"],["هكــذا عـَـهــدي قــديـمُ","قبل كَوْنِ الكَوْنِ كانْ"],["يَـــدْريــــهِ فـــتًـــى كريـــمُ","قد ضاءَ منهُ الجَنانْ"],["فلَــهُ ذوقٌ ســـلـــيـمُ","يدِقُّ عنِ الأذهـــــانْ"],["يعْرِفْني أنّي كـلـيـمُ","مُنَــاجِــيٌّ لـلــرّحــمـــنْ"],["وصراطـي مُـسـتـقيمُ","مُوَصِّــلٌ للإيــــقـــــانْ"],["يسْلُكْهُ فتًى حَزيمُ","مُــــدَرَّعٌ بـــــالإيــــــــمـــانْ"],["حضـرَتي محضُ نعيمٍ","وجَنَا الجِنَانِ جَانْ"],["فيها من ماءٍ تسنيمٍ","مِن كلّ شيءٍ زوجانْ"],["مُحِبِّي فيها مُقيمٌ","بين حُورٍ وَوِلْدَانْ"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":147,"printedNumber":55,"tocTitle":"يا سُقـاةَ الرَّاحِ قُومُـوا"},"n":56,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}