{"id":"qec2db31","title":"العَـلاوِي يَتكلّـمْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["العَلاوي يتكَلَّم","يا مَن هُو يَسمعْ فيه"],["على الحاضِرينْ يسَلِّم","رُدّوا السَّلامَ علِيه"],["والعلاوي يا فُقْرا","يوَصّي أهلَ الحضـرَة"],["إذا تُريدوا الخَمْرَة","عَلَيكُمْ بِمَعانِيه"],["والعلاوي يُنَادي","يَقُولُ يا أولادي"],["من يَحفظ وِدادي","أنا الذّي نَسقِيه"],["وصاحبُ التصديقِ","يَشـرب منَ الإبريقِ"],["من خمرةِ التّحقيقِ","بِيَدِيَّ نَرْوِيهْ"],["والمُريدُ الصّادق","إلّي ديمَا شَايق"],["يضحى قَلبُه شَارِقْ","وأنا نَرويهْ"],["ربي يغفر لِينا","فيما قد جَنَيْنَا"],["بحقّ نَبِينَا","صلى اللهُ عليه"],["وعبدكُم المداني","يَنْطِقُ بالبَيان"],["سلامٌ يا إخوَاني","رُدُّوا السّلام عليه"],["المريدُ الخائن","ديمَا في الغَبَائِن"],["قلبه بالمَحَايِن","شَيطَانُه غَاوِيهْ"],["يبقى حَائِر أمرُه","يثقُل عَليه"],["ذَكِّرْهُ حتى لا يَعْظُم وِزرُه","يا ربّي تَهْدِيه"]],"widths":[4270,4337],"gaps":[1016]}],"source":{"pdfPage":45,"printedNumber":9,"tocTitle":"العَلاوي يَتكلّم"},"n":9,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[{"note":"","src":"https://archive.org/download/zawiya-recordings/irshadiya-9.mp3","reciter":"","i":1}]}