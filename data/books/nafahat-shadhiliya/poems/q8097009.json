{"id":"q8097009","title":"يا مُـريدَ السـرّ سلِّـمْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يــا مُــريــدَ السّـرِّ سَـلّمْ","لا تُـــنـــكِــر عَـلَيْــنَــا"],["خَـلِّ فـهـمَـك عـنّـي واقدِمْ","كـــي تـــأخــذ عَــــــلَيْــنَــا"],["إنْ كُـنـتَ مِن قَبلي تَعلَمْ","لا تَــحـــتَـاج إليــنَـا"],["عِــلمُــنـا والله يـعـظُـم","لا يـــهُـــونُ عَـــلَيْـــنــا"],["إن كـنـتَ مُـريـداً تَزعـم","فـــالمـــطــلوبُ فــيــنــا"],["إن تــرَ لغــيـري مَـنـجَـم","فــاقــصِــدهُ يــكــفــيـنـا"],["مـن ذاقَ ذا السّـرّ يحكُم","والله عــــــلَيْــــــنـــــا"],["إنّــنــي فـِـيــهِ مــتـقَـدّم","والفَــــضــــلُ إلَيْــــنــــا"],["لســتُ فَاشـي ولا كَـاتِـمْ","بَــيـــنَهُــمُ وبَــيْـــنَـــا"],["نُؤتي الحكمة ولا نَحرِم","مَــنْ حــظُّهُ فـيــنَــا"],["نـرجـو بذا السَّير نَسْلَمْ","والمَــوْلى يــكــفــيــنــا"],["شـرَّ النـفـسِ كـمـا يـعلَم","لا تَـــصَـــرَّف فـــيـــنـــا"],["صـــــلّ يـــــا ربّ وســــلّم","عـــلى رُوحِ نَـــبـــيـــنَــا"],["وعـــلى كُـــلّ مُـــحْـــتَــرَمْ","مـِــن أَهـــلِ المــديــنــا"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":82,"printedNumber":47,"tocTitle":"يا مُريدَ السرّ سلّمْ"},"n":47,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[]}