{"id":"q5c23e6a","title":"يا مَنْ ظَهَرتْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":3,"rows":[["يا مَن ظَهَرتْ","بِنورهِ الأكوانُ","أَنتَ الظّاهِرْ"],["حَتّى كَانُوا","مَع أنّهُم مَا كَانُوا","أَمرٌ بَاهِرْ"],["هَذا شَانُوا","فَلِذَا مَا شَانُوا","حكيمٌ ماهرْ"],["حَيثُ زانوا","ألا وَقد زَانُوا","عَرْفٌ عاطِرْ"],["عَنهُ لَهُوا","كَيفَ وَهمْ لَهُ","بَدرٌ زاهرْ"],["فيهِ تَاهُوا","كَما هُم انتهُوا","فردٌ لا غيرْ"],["كثير غدا","وللأرواح غذَا","بِرٌّ وضيرْ"],["سِحرٌ هذا","أو ما تراهُ هُدَى","فكُن حاضرْ"],["لقد آنَا","وَجهُ المَحبُوب أنا","لهُ سَاترْ"],["بذا لَانَا","كلّ قَلب لَنا","صَار ذاكِرْ"],["لمّا جَانَا","وللقُليبِ جَنا","غَدا طَائرْ"],["فيه بَنـى","ومن ذاتِه بَانَا","صَارَ حَائِرْ"]],"widths":[2408,3402,2395],"gaps":[709,709]}],"source":{"pdfPage":149,"printedNumber":58,"tocTitle":"يا مَن ظَهَرت"},"n":59,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}