{"id":"qff9c5f8","title":"تَيــــهـتْنِي ذَاتُـك","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["تيّهَتْني ذاتُك","وغِبتُ فيكْ يا الله"],["ظَهَرتْ صفاتُك","مِنكَ وَفيكْ يا الله"],["لِمَن نحكي سـرّي","لِمن نُريكْ يا الله"],["رجعْتُ لسُكرِي","وحِرْتُ فيكْ يا الله"],["دخلتُ لِلْمعنى","لِكَي نراكْ يا الله"],["نُوديتُ مَن أنا","لستُ سواكْ يا الله"],["خرجتُ لِلحسّ","نَفتشْ عَلَيْكْ يا الله"],["ابْتَدَيْتُ بنفسـي","حَصَّلْت عَلَيْكْ يا الله"],["ظهَرْتَ في الكُلّ","عَمّن نُخفِيكْ يا الله"],["ومَنْ كانَ مِثلي","يَسْتُر علَيْكْ يا الله"],["أنت هُوَ الظاهر","في ذا العَبِيدْ يا الله"],["أنت هُوَ الباطن","كما تُريدْ يا الله"],["وفي بدء السّيرِ","وهِمْتُ فيكْ يا الله"],["ظننتُكَ غيري","جاوزتُ علَيْكْ يا الله"],["حتى نارت شمسـي","دلّتْ علَيْكْ يا الله"],["نُوديتُ من نفسـي","قلتُ لبَّيْكْ يا الله"],["خرجتُ للنّاسِ","نحكي علَيْكْ يا الله"],["في جميع أنفاسي","مْوَلَّعْ بكْ يا الله"],["خشَيْتُ عن قلبي","يغفَلْ عَلَيْكْ يا الله"],["وأنتَ في قُرْبي","حَقِّقْني بكْ يا الله"],["أشْغِلْني بكْ نَفنى","عمّا سواكْ يا الله"],["وابقِني بكْ نَغنى","حتّى نراكْ يا الله"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":125,"printedNumber":33,"tocTitle":"تيّهتني ذَاتُـك"},"n":34,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}