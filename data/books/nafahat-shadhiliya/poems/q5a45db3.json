{"id":"q5a45db3","title":"علَى الحَـــــقِيقَـة اجْتمَـعْنَا","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["علَى الحَــقِيقَة اجْتَمَعْنَا","نَـحْنُ وَأَهْـلُ اليَقِـينِ"],["نَحْكِي حَديــــثَ حَبيـبٍ","يَحْكِي رِيَاضَ الغُصُـــونِ"],["يحْكـِـــي شَـرَابًا مَخْتُـومًـا","مِنَ الرَّحِيــقِ يَشْـفِيـنِي"],["حَدِيـــثُ الـحُبِّ مُنــايَ","وَحُـبُّ اللهِ يَكْــفِيــنِـي"],["إِذَا تَـــجَلَّى حَـــبِيبِـي","عَلَى الأَكْــوَانِ يُفْنِيـــنِـي"],["أَفْنَــى بِالحُـــبِّ وَأَبْقَـى","وَالقُــرْبُ منــه يُبْــقِيــنِـي"],["أَيَـا عَــذُولِيَ دَعْـــنِـي","فَإنَّ العَذْلَ يُــغْرِيــنِـي"],["وَلاَ تَلُــــمْــنِي فَلَــوْمِي","يَــزِيــدُنِي فِي تَــمْكِيــنِـي"],["هَـذِهِ مَـــعَانٍ عِـــظَامٌ","فِيهــا هُــــدَايَ وَدِينِــي"],["وَفِيهَـا تَوْحِــــيدُ رَبِّــي","المَـالِكِ يَـــومِ الدِّيـنِ"],["مَالِي سِـــوَاهُ مُــرَادٌ","أَرْنُو إلَيهِ بِعَـيْنِـي"],["إلّا الَّذِي بِـهُـــدَاهُ","هُدِيتُ إِلَى اليَـــــقِينِ"],["خَيرُ البَـرَايَا نَبِيــــــنَا","مُحَمَّـــدٌ الأَمِــــينِ"],["فَاجْعَلْـهُ رَبِّي شَــــفِيـعِي","مِنَ النِّيـــرَانِ يُنْـجِـينِي"],["أَنَا الـمُحِبُّ فَاقْـــبَلْــنِي","أَنَا المَدَانِي المَـــدْيُـونِي"],["وَسِيلَتِـي ومَقْـــصُـودِي","رَسولُ اللهِ يَحْــمِيـــنِي"],["صَلَّى اللهُ عَليهِ وَسَـــــلَّمْ","طُولَ الـمَدَى وَالسِّـــنِينِ"],["وَالآلِ وَالصَّــــحْبِ دَوْمًـا","وَتَابِعِـيهِمْ فِي الدِّيــــنِ"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":109,"printedNumber":17,"tocTitle":"علَى الحَقِيقَة اجتَمَعنَا"},"n":18,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}