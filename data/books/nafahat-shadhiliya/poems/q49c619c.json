{"id":"q49c619c","title":"أيُّها السّائِلُ أنتَ الكَـفِيلُ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["أيُّها السّائِلُ أنت الكَفِيلُ","بِجَوابِنا عَنِ الآفَاتْ"],["فَهَاكَ قولًا فيه تَفصيلُ","مَحضُ البَيانِ في الـشّطحاتْ"],["فَكُلُّ شَيءٍ لهُ سَبيلُ","وكُلُّ ذَاتٍ لَها سِمَاتْ"],["وَكُلُّ حَقٍّ لهُ دَليلُ","وكلُ صدقٍ لـه ثَبَاتْ"],["وَكُلُّ خِلٍّ لهُ خَليلُ","وكلُّ رِقٍّ لهُ سَادَاتْ"],["وَأَمري لَيسَ لهُ مَثِيلُ","فَأنتَ عَنهُ في سَكَراتْ"],["فَمَا تَراهُ مِنّا بَاطِلُ","فَلستَ تَدرِي كُنْهِـي هَيهَاتْ"],["مَا دُمْتَ تَرى أنّي قَابِلُ","لأيّ شَيءٍ مِنَ الصّفَاتْ"],["كُلُّ التّعظـيمِ فِينَا قَليلُ","كالاحْتِقَارِ في المُسَاوَاتْ"],["عِلمُكَ فينا أنّي جَمِيلُ","وبالعلاوي وُسِمَتِ الذّاتْ"],["فَمَا بَينَنا سَفَرٌ طَويلُ","كَمَا بينَ الحيِّ وَالأمْوَاتْ"],["فَأمْرِي غَيبٌ عَليكَ مُحِيلُ","وحُسْنُ الظَنِّ فيهِ نَجَاتْ"],["فَكُلُّ فَهمٍ فينا كَلِيلُ","فَكَمْ لِلعَقلِ مِن عَثَرَاتْ"]],"widths":[4241,4305],"gaps":[1080]}],"source":{"pdfPage":72,"printedNumber":35,"tocTitle":"أيُّها السّائِلُ أنت الكَفِيلُ"},"n":35,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[]}