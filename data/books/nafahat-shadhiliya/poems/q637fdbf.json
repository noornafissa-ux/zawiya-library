{"id":"q637fdbf","title":"يَـتهتّكْ حِجَـابي","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يَتَهَتَّكْ حِجَابِي","إِذَا مَا قُلْتُ اللهْ"],["تَرَانِي في انْتِحَابِ","إِنْ نَظَرْتُ إِيَّاهْ"],["وَالجِسْمُ فِي اضْطِرَابِ","وَالعَقْلُ فِيهِ تَاهْ"],["وَالغَيْرُ فِي ارْتِيَابِ","جَاهِلٌ بِمَوْلاَهْ"],["مُقِيمًا فِي احْتِجَابِ","يَفْتَخِرْ بِعَمَاهْ"],["فَمُنْکِرُ اقْتِطَابِي","غَبِيّ لاَ عِلْمَ لَهْ"],["جَاهِلٌ بِانْتِسَابِي","يَحْسِبْ أنِّي سِوَاهْ"],["لَيْتَهُ يَعْلَمْ مَا بِي","يَعْذُرْنِي فِي هَوَاهْ"],["وَيُسْقَى مِنْ شَـرَابِي","يَهْتَدِي بِهُدَاهْ"],["هُدَايَ وَاقْتِرَابِي","مِنْهُ بِهِ وَلَهْ"],["مُرَادِي وَاحْتِسَابِي","يَنْتَهِي فِي رِضَاهْ"],["سُـرُورِي وَانْطِرَابِي","هَوَايَ بِهَوَاهْ"],["جَمَالُ الحَقِّ سَابِي","تَيَّهنِي مَعْنَاهْ"],["لاَ نَخْشَـى مِنْ عِتَـابِ","لَوْ قُلْتُ بِرُؤيَاهْ"],["ظَهَرَ فِي احْتِجَابِ","وَاخْتَفَى بِسَنَاهْ"],["وَالكُلُّ فِي خَرَابِ","لَوْلَاهُ مَا تَرَاهْ"]],"widths":[4241,4303],"gaps":[1083]}],"source":{"pdfPage":150,"printedNumber":60,"tocTitle":"يَتهتّـك حِجَابِي"},"n":61,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}