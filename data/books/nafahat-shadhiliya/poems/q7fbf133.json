{"id":"q7fbf133","title":"الدَّهـرُ ذُو ـأمـوَاجْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":3,"rows":[["الدَّهرُ ذُو أموَاجْ","عِنْدِي فِيهِ فَرْجَة",""],["","جَاءَ بِعْيونْ دْعَاجْ","وَفِي فِيهِ فَلْجَة"],["لَهُ خَدّ وَهَّاجْ","كَأَنَّهُ عِلْجَا",""],["","في جِيدِهِ مِعرَاجْ","نَبْلُغْ بِهِ المَلْجَا"],["طَوْرًا بِيَ يَعْوَجْ","يُلْقِينِي فِي لُجَّة",""],["","عَنِّي طَورًا يَغْنَج","يَتـرُكنِي نَتْلَجَّا"],["يَفْعَلْ فِعْلَ الحَجَّاجْ","يَحْكُمْ بِلَا حُجَّة",""],["","يَتـرُكنِي دُونَ عِلَاجْ","نَتْلَطَّمْ فِي هَرْجَة"],["قَالَ الدَّهْرُ اَلحَرِيجْ","كُفَّ مِنَ التَّعوِيجْ",""],["","إيش هَذَا اللَّهِيجْ","بَالَغْ فِي لْجَاجُو"],["كُفَّ القَوْلَ السَّمِيجْ","وَاِنْطَقْ بِالتَّدرِيجْ",""],["","إِنَّكْ لِي حوِيجْ","مِثْلُكَ يَحْوَاجُو"],["قُلْتُ لَهُ مُحْتَاجْ","وَلِغَيْرِكَ مَا نَرْجَى",""],["","إِلَّا أنّكَ تَعوَجْ","مَا رَيتْ مَعَكْ نْجَاة"],["تَحْسَبُ أَنِّي هَمَاجْ","تَتْرُكْنِي فِي مُرْجَة",""],["","نَتْقَلَّبُ فَوْقْ خمَاجْ","وَأنْتَ تَصْعَدْ دَرْجَة"],["تلْبَسْ منَ النُّورْ دِيبَاجْ","حَاكِمْ عَلَى الهَيْجَا",""],["","مَالِكْ ظَرِيفْ التَّاجْ","وَأنَا بَاقِي نَرْجَى"],["خُذْ فِي يَدِكْ مِنْهَاجْ","وَاعْلَمْ أَنِّي حَاجَة",""],["","كَوْكَبْ دُرّي وَهّاجْ","مِصْبَاحْ فِي زُجَاجَة"],["نَفسُكْ عَنْكَ تَهِيجْ","فَاحْذَرْ بِكَ تَمِيجْ",""],["","تَرْمِيكَ عَلَى خَلِيجْ","تَهْلُكْ بَعِواجُو"],["قُلْتُ لَهُ تَغْنَجْ","تَايِهْ عَمَّنْ يَلْجَا",""],["","حَكَمْتْ عَلَى الحلَّاجْ","تَزْعُمْ حُكْمْ بصَنْجَة"],["كَمْ مِنْ نَبِيّ لَهّاجْ","مَبْعُوثْ بِالْحُجَّة",""],["","تَعْمَلْ بِهِ هرَجْ","تَسُدّْ بِهِ فُرجَة"],["دَايِمْ رِيحَكْ عَجَاجْ","مِنْهُ حَالِي ضَجّا",""],["","مَاذَا يَقضـِي السّـراجْ","فِي رِيحْ عَلَى عَرْجَة"],["فَالكُلُّ لَكُمْ رَاجْ","وَالحَقْ مَعَكُمْ جَا",""],["","مَنْ ذَا يَقْدِرْ يَعْوَجْ","يَكْفِي مِنْ ذِي الهَرْجَة"],["جَاء ذَا الدَّهْرُ البَهِيجْ","بِمَحَاضِرْ وَبَنِيجْ",""],["","وَتقدَّمْ لِلعَليجْ","وَأشْفَقْ مِنْ شاجُو"],["يَجِدْ حَالِي دَلِيجْ","يَتَخَلَّجْ تَخْلِيجْ",""],["","يَقْرُبُ مِنَ النَّضِيجْ","مَعْذُورْ خْلَاجُو"],["حَالِي دَم