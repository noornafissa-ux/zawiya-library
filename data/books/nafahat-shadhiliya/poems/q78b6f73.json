{"id":"q78b6f73","title":"يا سَاكنَ الحَشا والجِسْمِ وَالضُّلُـوعْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يَا سَاكنَ الحشا","والجِسمِ وَالضُّلوعْ"],["فَقُّ قلبي فَشا","بِمعاني الجُموعْ"],["فَفي حُبِّ رَشا","لُذَّ لي الخُضوعْ"],["ذُلّي كذا الوَحشَة","والعُزلَة والدّموعْ"],["طار العقلُ طَاشا","منها صار هَلوعْ"],["حين أغْشـى ما أغْشـى","عند السّقْفِ المرفُوعْ"],["منها أنا في دهشَة","عند فقد الرُّبوعْ"],["فارقتُ الجسمَ أمشـي","وعَدِمْتُ الرُّجوعْ"]],"widths":[4241,4303],"gaps":[1083]}],"source":{"pdfPage":147,"printedNumber":54,"tocTitle":"يَا سَاكنَ الحَشا والجِسمِ وَالضُّـلوع"},"n":55,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}