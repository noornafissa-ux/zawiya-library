{"id":"q424e1dd","title":"يا سَائِقَ الأفكَـارْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يَا سَائِقَ الأفْكَارْ","فِي مَيْـدَانِ السِّـرِّ"],["يَا حَادِيَ الأعْمَارْ","سِيرُوا عَلَى قَدْرِي"],["إِنَّنِي عَبْدُ الدَّارْ","تَابِعْكُمْ فِي الأمْرِ"],["وَالضُّعْفْ علَيَّ جَارْ","فَالْتَمِسُوا عُذْرِي"],["بُعْدُكُمْ لِيَ نَارْ","وَقُرْبُكُمْ ذُخْرِي"],["حُبُّكُمْ فِيَ سَارْ","مُـزِجَ بِسِـرِّي"],["لَوْ رَأَتْكُمْ الأحْبَارْ","لَحَنُّوا لِلذّكْرِ"],["وَمَزَّقُوا الزُّنّارْ","وَتَاهُوا بِالسُّكْرِ"],["سُمِّيتُمْ فِي الأَسْحَارْ","بِلَيْلَةِ القَدْرِ"],["قُرْبُكُمْ شَاوَ نْهَارْ","مُكَنَّى بِالفَجْرِ"],["كُنْتُ قَبْلَ الإِقْرَارْ","مَحْجُوبًا عَنْ أَمْرِي"],["وَأنْتُمْ مَعِي فِي الدَّارْ","وَأَنَا مَا نَدْرِي"],["حِينْ رُفِعَتْ الأسْتَارْ","وَحِجَابُ النُّكْرِ"],["غِبْتُ عَنِ الآثَارْ","فِي شُهُودِ البَدْرِ"],["سِوَاكُمْ مَا يُذْكَرْ","فِي ذِهْنِي وَفِكْرِي"],["لَوْ كُنْتْ علَى الجِمَارْ","نَتْقَلَّـبْ فِي عُسْـرِي"],["أَنْتُمْ مَعِي فِي النَّارْ","فَيَا لَيْتَ شِعْرِي"],["لَوْ كُنْتُ لَكُمْ جَارْ","فِي مُدَّةِ الدَّهْرِ"]],"widths":[4241,4297],"gaps":[1083]}],"source":{"pdfPage":144,"printedNumber":52,"tocTitle":"يَا سَائِقَ الأفكـارْ"},"n":53,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}