{"id":"q60c4526","title":"أيّهَا الإخْوانُ هذا جَمـعُ الإلهِ السَّلامْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["أَيُّـــــــهَا الإِخْــــوَانُ هَــــذَا","جَمْــعُ الإِلَــــهِ السَّــلاَمْ"],["قُطْبُــهُ الغَوْثُ الْــــمُفَـــدَّى","شَيْخُنَــا نِعْـــــمَ الإِمَـــامْ"],["زَادَهُ الإِلَـــــــهُ عِـــــــــــــــزًّا","وَأَبْقَــــــــاهُ بِالــــــدَّوَامْ"],["أَحْمَـدُ العَــلاَوِي فَــــــــرْدٌ","وَاحِــدٌ بَيْــــــــنَ الأَنَــــامْ"],["شَعْـشَعَتْ أَنْــوَارُ شَمْـــسٍ","مِنْـهُ فِـي هَــــذِي الأَيَّــامْ"],["فَاقْتَبَسْــنَــــا مِنْـــهُ نُـــورًا","نَمْشِـي بِــــهِ فِي الظَّـــلاَمْ"],["ضَـاءَ الْقَلْـبُ حَتَّــــى صِرْنَا","كُلّـنَا مِثْــــــــل الأَعْــــلاَمْ"],["شَمْسُـكَ ضَـاءَتْ عَلَيْــنَـا","مِنْ خَلْـــفٍ وَمِنْ أَمَــــامْ"],["هَـامَ قَلْبِـي وَحَشَـــــــــــايَ","نَارُ شَوْقِـي فِـــي اضْطِـرَامْ"],["غَيْرَ أَنِّـي فِـي ذَا الْيَــــــوْمِ","زَادَنِـــــــــــي حَــــرُّ الأَوَّامْ"],["وَفُـؤَادِي قَــــــدْ تَقَــــطَّعْ","إِذِ الجَمْـــــــعُ لاَ يُسَـــــــامْ"],["وَعَـــــــذابُ البَيْـــــنِ لَاحَ","جَــــــــــرَّدَ مِنْــهُ الحُسَــامْ"],["قُـلْ لَــهُ مَهْــــــــلًا فَإِنِّــــي","عَاشِـقٌ فِـــــي ذَا المَقَـــامْ"],["لاَ تُعَجِّـلْ بِالفِـــــــــرَاقِ","إِنّـهُ صَعْــــــــــبُ المَــــرَامْ"],["تَاللهِ مُـرُّ الْــــــمَــــــذَاقِ","لاَ تَحْمِلُـــــــــــهُ الكِـــــرَامْ"],["فَقُـلْ لِي يَا عَيْـنُ قُـلْ لِـي","من تَـــــــــرى بعدَ الهُمام"],["هَلْ تَرَيْــــنَ عَنْـهُ غَيْـــــرًا","هَلْ مِــــــنْ بَعْدِهِ تَنَــــامْ"],["وَيَا أذْنُ مِـمَّنْ تُصْغِـــــي","مِنْ جَوَاهِــــــــــرِ الْكَــلاَمْ"],["أَيُّهَـا الضَّمِيـــرُ خَبِّـــــرْ","وَاصْدَعَنْ بَـــيْنَ الأَقْـــــوَامْ"],["قُلْ لَهُــــمْ لاَ أَسْتَطِيــــــعُ","عَنْكُــمُ صَبْــــرًا يُــــرَامْ"],["كَـيْفَ أَسْلُـو كـيْفَ أَسْلُـو","كَيْفَ أَسْلُــو يَـــــا كِـــرَامْ"],["لاَ وَاللهِ يَــــا فُــــــؤَادِي","قُلْ لَهُـــمْ هَـــــــذَا حَـــرَامْ"],["رَافِقَــــنْ يَا رُوحُ قُطْبًـا","واذْهَبَـــــــنَّ بِسَـــــــــلَامْ"],["فَــارِقِ الجِسْـــــمَ وَلَازِمْ","خِدْمَــةَ هَـــــــذَا الإِمَــــام"],["إِنَّنِـــــي الْـمَدَانِـي عَبْدٌ","مَـــمْلُـوكٌ عَــلَى الــدَّوَامْ"]],"widths":[4270,4337],"gaps":[1016]}],"source":{"pdfPage":50,"printedNumber":12,"tocTitle":"أيُّهَا الإخوان هذا جمعُ الإلهِ السّلام"},"n":12,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[]}