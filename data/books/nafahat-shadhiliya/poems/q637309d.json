{"id":"q637309d","title":"أَبْغِي ثَبَاتِي","author":"سيّدنا الشيخ إسماعيل الهادفي","blocks":[{"cols":2,"rows":[["أَبْغِي ثَبَاتِي","فِي شُهُودِ بَحْرِ الذَّاتِ"],["أَغْنَمْ أَوْقَــاتِي","فِي رُؤْيَةِ الذَّاتِ العَلِيَّة"],["بِكُمْ حُضُورِي","مَـعْ جَمَالِ نُـورِ النُّـورِ"],["فَــوْزِي وَسُـرُورِي","رُجُوعِي إِلَى الكَنْزِيَّة"],["تُهْتُ بِالذَّاتِ","مُذْ كَانَتْ ذَاتِـــــي وَصِفَاتِي"],["طَابَتْ أَوْقَــاتِي","مِنْ تَجَلِّيهَا عَلَيَّ"],["ثَابِتْ مَقَالِي","فَالغَيْرُ مَحْضُ خَيَالِ"],["كُلُّ المِثَالِ","مَجَالِي الـذَّاتِ العَلِيَّـــة"],["جَنَّةُ حُــبِّي","فَوْزِي بِالوَصْلِ وَالقُرْبِ"],["مُتْعَةُ قَلْبِي","نُورُ الْحَضـرَةِ الأحَدِيّة"],["حِـبِّي دَعَانِي","وَبِوَصْلِهِ حَبَانِي"],["بِــلَا تَوانِي","أَفْنَانِي فِيهِ رُقِيَّا"],["خَـــفَّ مَسِيرِي","بِنَوَالِهِ الْغَزِيرِ"],["سَـقَى ضَمِيرِي","خَمْرَةً بَدَتْ عَلَيَّ"],["دَعَـا جَنَانِي","سَقَاهُ خَمْرَ التَّدَانِي"],["نِلْتُ الأَمَانِي","فِي جَمَالِ الوَاحِدِيَّة"],["ذِكرُهُ يُدْنِي","وَعَنِ الأَكْوَانِ يُفْنِي"],["اللهُ أَعْنِي","لاَزِمْهُ تَرْقَى رُقِيَّا"],["رَبُّ الْعِبَادِ","أَنْتَ قَصْدِي وَمُرَادِي"],["يَوْمَ التَّنَادِي","أَرْجُوكَ الرِّضَا عَلَيَّا"],["زَادَتْ أَفْرَاحِـي","مُذْ كُنْتُ سَكْرَانْ وَصَاحِي"],["زَالَـتْ أَتْرَاحِـي","بِالأنْوَارِ القُدُسِـيَّة"],["طِبِّي وَطَلَبِي","طَرَبِي تَطْهِيرُ قَلْبِي"],["زِدْنِـي فِي القُرْبِ","وَاغْفِرْ لِي كُلَّ خَطِيِّة"],["ظَنِّي جَمِيلُ","وَأَنَتَ الرَّبُّ الْجَلِيلُ"],["أَنْـتَ الْكَفِيلُ","فَكُنْ لِي رَبِّي وَلِيَّا"],["كَـمْ مِنْ ذَلِيلٍ","عَـزَّ بِالفَضْـلِ الجَزِيـــلِ"],["بِـلَا مَثِيلٍ","أَجْزَلْتُمْ لُهُ العَطِيَّة"],["لَمْ أَرَى غَينًا","مُذ صَارَتْ غَيْنِي عَيْنًا"],["مَا ثَمَّ أَيْنًا","إلَّا الأَنْوَارُ الذَّاتِيَّة"],["مَلِّكْنِي حَـالِي","وَاعْطِينِي أَقْصَـى نَوَالِي"],["عَـلَى التَّوَالِي","اسْقِنِي خَمْرَة نَقِيَّة"],["نُـورُ الْجَمَالِ","تَجَلَّى بِلَا مِثَالِ"],["فِـي كُـلِّ حَـالِ","بِالمَظَاهِرِ الكَوْنِيَّة"],["صَفَـا شَـرَابِـي","تَلَذّذْتُ بِالخِطَابِ"],["طـوْرُ الجَنَابِ","قَدْ بَدَا يَقِينًا فيَّ"],["ضَاوِي كَلَامِـي","للَّذِي ي