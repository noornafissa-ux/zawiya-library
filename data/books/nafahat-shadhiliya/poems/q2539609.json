{"id":"q2539609","title":"يا مُنْكـرًا عِلـمَ القُـلُوبْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["يَا مُنْكِرًا عِلْمَ القُلُوبْ","عَنْ أَهْلِ اللهِ البُلَغَا"],["اِسْمَعْ لِقَوْلِي يَا مَحْجُوبْ","ولَا تَكُنْ مِمَّنْ طَغَى"],["عِلْمُ الحَقِيقَةِ مَطْلُوبْ","فِي شَـرْعِ اللهِ يُبْتَغَى"],["وَمَنْ أَنْكَرَهُ مَسْلُوبْ","عَن الإِحْسَانِ قَدْ بَغَى"],["سِـرُّ الأسْـرَارِ وَالغُيُوبْ","يَرْوِيهِ قَوْمٌ نُبَغَا"],["عَنْ طَلْعَةِ البَدْرِ المَحبُوب","عنِ الإلهِ بلّغَا"],["وحُكْمُهُ قَالُوا الوُجُوبْ","وفَرضُ العَيْنِ لَا يُلْغَى"],["فَتدْرِكُ بِهِ المَرْغُوبْ","بِدُونِهِ لَنْ تَبْلُغَا"],["اِرْجَع إِلَى الله وَتُبْ","خَيْرُ العِبَادِ مَنْ صَغَى"],["فَاللهُ يَغْفِرُ الذُنُوبْ","وَيَعْفُو عَمَّنْ قَدْ لَغَا"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":57,"printedNumber":21,"tocTitle":"يَا مُنكِراً عِلمَ القُـلُوبْ"},"n":21,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[]}