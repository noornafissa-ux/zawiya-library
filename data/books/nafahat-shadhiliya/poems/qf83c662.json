{"id":"qf83c662","title":"أَهْـــلُ اللّهِ رَاهُــــمْ حَــــازُوا","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["أَهْـــلُ اللهِ رَاهُــــمْ حَــازُوا","يَـــا سَامِـعْ قَوْلِـي اصْغَاهْ"],["بَلْغُــوا مُــناهُم لَمَّـا جَـــازُوا","وَفَنَـــــــوْا عَمَّــــا سِــــــــوَاهْ"],["شَغْلُوا عُمُرَهُم حَتّى فَــازُوا","بِــلَا إلَـــهَ إلّا اللهْ"],["بِـــهَـا وَصلُـوا لِلمطلوبْ","كَنْزُهُــــــمْ ذَاكَ المَرْغُــوبْ"],["شَاهَـــدُوا نُورَ المَحْبُــوبْ","تَجَلَّـــى لِمَــنْ رآهْ"],["خُذْهَــا صِقَـــالِ القُلُـوبْ","لا إلَه إلا اللهْ"],["تَجَلَّــى جَمَــالُ الـــذَّاتْ","وَكَـــذَا كُــلُّ الصِّفَــاتْ"],["فِـــــــي مِـــرْآةِ الكَائِنَـــاتْ","إذَا شِــئْــــــــتَ أنْ تَـــــــرَاهْ"],["عَلَــيْكَ بِخَيْـــرِ الكِلْمَـات","لا إلَه إلا اللهْ"],["ثَبِّـــــتْ يَــا رَبِّــي حَدِيثِـــي","وَارْحَمْنِــي بِخَيْـرِ الغَــيْثِ"],["واجْعَلْنِـي كَصَيْـدِ اللَّـيْـثِ","يَحْمِـي مَنْ يَدْخُلْ حِمَاهْ"],["وَاجْعَـلْ مَسْكَنِــي وَلُبْثِــي","لا إِلَهَ إِلّا اللهْ"],["جُــــــودِكْ يَا رَبِّـي نِتْرَجَّــى","لَيْسَ لِـي سِـوَاكَ مَلْجَا"],["أَعْمَـــاليِ عَـلَيَّ حُـــجَّـة","وَذَنْبِـــــــي فَضْلِك غَــــطَّاهْ"],["وَحِصْنُك إِلَــــيَّ مَنْجَــــا","لا إِلَهَ إِلّا اللهْ"],["حَبِيبِــي بِذِكْــــره نَرْتَــــاحْ","وزمَــــــــانِي كُلّـو أَفْـــرَاحْ"],["شَفِيعِــي البَــدْرِ الوَضَّـــاحْ","مُحَمَّــدْ رَسُـــــــــولُ اللهْ"],["مَنْ جَـــاءَ بِـذِي المِفْتَـاحْ","لا إِلَهَ إِلّا اللهْ"],["خَفِّـفْ يَا رَبِّـي أَوْسَاخِـــــي","إِنَّ فِـي عَمْلِـــــــي تَرَاخِـي"],["واجْعَلْ ذَنْبِـي فِي انْتِساخِ","وَاعْــــــطِ لِقَلْبِــــــــــي مُنَـاهْ"],["مُنْيَــةَ الفُـــؤَادِ السّــــــاخِـي","لا إِلَهَ إِلّا اللهْ"],["دَعَــــــانِـــــي رَبُّ العِبَــــــادْ","بَلِّغْنِـــــــي فَـــوْقَ المُــرَادْ"],["وَاكْشِفْ لِي حُـجْـبَ الإِبْعَـادْ","إِنَّنِـــــــي رَاجِــــي أَرَاهْ"],["دَلِيلِـــــــي خَيْـــــــــرَ الأَوْرَادْ","لا إِلَهَ إِلّا اللهْ"],["ذِكْــرُ الله خَيْـــــــرُ لَـــــذَّه","لا يُحصـى فَضْـلُـه لاَ يُحْـذاَ"],["سِـرّ عَظِيمْ قُل لِي منْ ذَا","يَقْـدِرْ عَلَى عَدّه وَإحْصَاهْ"],["أفْضَلُ الأَقْــــــوالِ هَــــــذَا","لا إِلَهَ إِلّا اللهْ"],["رَوْضُ قَلْبِـي بِـــهَا أَزْهَــــرْ","وَفُــؤَادِي قَــــــــــدْ تَنَـــــــوَّرْ"],["مُذْ سُقِي المَـاءَ المُطَهَّــرْ","مَـاءُ التَّــوْحِيــدِ يَا مَـحْـــلاَهْ"],["غُــصْنُهُ البَاهِي المُعَطّـــر","لا إِلَهَ إِلّا اللهْ"],["زَادَنِــــــي الإِلَـــهُ عِـــــــزًّا","لَمَّا كَـانَ وَصْفِــي العَـجْزَا"],["مَــدَّنِي نَصْــــــرًا وَعِـــــزًّا","ولاَ عِــــــــــــزَّة إلاَّ بِــــالله"],["وَأَعْـــطَانِي ذُخْـرًا وكَنْــزًا","لا إِلَهَ إِلّا اللهْ"],["طِبِّـــــــــيَ اللهُ فَقَــــــــطْ","وَالحَـــــــــبِيبُ المُغْتَبَــــــطْ"],["رَحْمَــــةُ الأُمَّــة الــوَسَطْ","لاَ تَــــــرَى عَيْنِــــي سِـــوَاهْ"],["اسْمُهْ بِاسْمِــهْ مُرْتَبِــــــطْ","لا إِلَهَ إِلّا اللهْ"],["ظَنِّي فِـي الحَـقِّ الرِّضَى","وَالعَفْـــــوُ عَمَّــــــا مَضَـــــى"],["وَاللُّطْـــفُ فِيــماَ قَـضَــى","والجَــــــــــــزَا مِنْكَ نَــــــرَاهْ"],["جَـــزَاءُ القَلْبِ المُرْتَضَـى","لاَ إلهَ إلاّ اللـهْ"],["كُـلُّ الخَلْــقِ فِـي حِمَـاكْ","وسِــعَهُـمْ رَبِّـــي رُحْمَـــــاكَ"],["تَغْفِـرْ لَـــنَا فِـــــي ذَا وذَاكْ","والشِّـرْكُ يُصْـلِــي مَنْ نَـوَاهْ"],["لَيْــسَ لِي عُمْــدَهْ سِــوَاكْ","لا إِلَهَ إِلّا اللـهْ"],["لَمْ يَخْطُـرْ غَيْـرُكْ فِي بَالِي","أَنْتَ مَشْهَدِي فِي الحَالِ"],["أَنْـــتَ كَنْــزِي فِـي المَــآلِ","فِـي يَــــــوْمِ المُـــلْـــكِ لله"],["رِبْــحِـي وَغِنَايَ وَمَـــالِــي","لا إِلَهَ إِلّا اللـهْ"],["مَبْـدَا الخَلْــــــقِ نُــــورٌ تَــمَّ","والظُّــهُورُ فِـيـــهِ حِكْـمَة"],["أَيْنَـــــــــــمَا تُوَلُّــــــوا ثَـــــــمَّ","وَجْــــــهُ الله لا سِــــــوَاهْ"],["وَالله ماَ أَعْظَـمْهَا كلمة","لا إِلَهَ إِلّا اللـهْ"],["نَبْلُــــــــغْ بِــــــــهَا المُنَــى","نُمْسِـــــي بِـهَـــا فِـي هَـنَا"],["عَلَيْـــكَ بِــذِي المَعْنَــــــى","لاَ مَوْجُـودَ إِلاَّ الله"],["كُـــــلُّ الخَلْــــقِ فِـي فَـنَـــا","لا إِلَهَ إِلّا اللـهْ"],["صَـادِقْ فِي حْدِيثِي ونَصِّـي","لاَ تَنْظُـرْ فِعْـلِي وَنَـقْصِـي"],["لاَ تُسَــمِّ قَوْلِـي بِالرُّخْـــــصِ","نَظْمِــــي مُتعَلِّقْ بِـــــاللهْ"],["فَضْلُ هَذَا لَيْـــسَ يُحْصَـــى","لا إِلَهَ إِلّا اللـهْ"],["ظَــــــاهِرُ الأَنْـــوَارِ حَظِّــــــي","تَمَتَّــــعْ قَلْبِــي وَلَحْظِــي"],["حَتَّـى صَـرَّحْ بِــهَا لَفْظِـــي","قَـــــائِــلاً رَبِّـــــيَ الله"],["هُـــوَ نَفْلِي هُوَ فَـــرضـــــــي","لا إِلَهَ إِلّا اللـهْ"],["عَلَيْـــكَ اعْتِمَـــادِي رَاجِـــعْ","فَضْــــلُكَ لِلْكُــــلّ وَاسِعْ"],["تَرْحَمُ العَــاصِي وَالطَّــائِـــــعْ","وَالإِخْـــــلاَصُ سِـــرُّ اللهْ"],["فَاعْتَــــــنِ بخَيْــرِ الـــــوَدَائِعْ","لا إِلَهَ إِلّا اللـهْ"],["غَالِـــي أَنْــــــــتَ المُبْتَغَــــى","قَلْبِـــي إلَيْكَ قَـدْ صَغَــى"],["مَــــا زَاغَ البَصَـرُ مَـا طَغَـــــى","عِنْــدَ التَّجَلِّي فِي مِـرْآهْ"],["مَـــنْ رَأَى غَيْــــــــرَك بَغَــــى","لا إِلَهَ إِلّا اللـهْ"],["فَالْـقِ السَّمْـــعَ وَاعْتَـــــــرِفْ","أَيُّــــهَا المُرِيــــدُ قِـــــــفْ"],["لاَ تَــــرَى غَيــــراً يُـوصَــــفْ","كِسْفَــةُ الفَـــنَا تَغْشَـــــاهْ"],["هَذَا أَمْـــرُ الحَــقِّ صِـــــــفْ","لاَ إلَهَ إلاّ اللـهْ"],["قَـالَ لِي القَـوْمُ العُشَّاقْ","أَهْـلُ الذَّوْقِ وَالأَشْوَاقْ"],["تَجَلَّــــــــتْ ذَاتُ الْخَـــلَّاقْ","حَتَّى غَـــابَ مَا سِــواهْ"],["خَيْرُ الْقَوْلِ عَلَــى الإطْـلاقْ","لا إِلَهَ إِلّا اللـهْ"],["سَلِّمْ رَبّي مِن الإِحْسَــاسْ","احْفَظْ قَلْبي مِن الوسْوَاسْ"],["أَعُـوذُ بِــرَبِّ النَّــــــاسْ","فِـــــــي القُرْآنِ قَـــــالَ الله"],["رُمْحِي لِطَعْـنِ الخَنَّـــاسْ","لا إِلَهَ إِلّا اللـهْ"],["شَوْقِي زَادَ فِي الحَشَــا","وَلَهِيــبِـــــي قَـــدْ فَشَــــــــــا"],["يَفْعَـــلْ رَبِّـي مَـا يَشَــــــــــــــا","فِــي الـذِّي حَبَّـهُ وَرَضَـاهْ"],["وَجِسْمِي أَضْحَى مُنْعَـــــشَـا","لا إِلَهَ إِلّا اللـهْ"],["هَــــذِه أَبْيَـــاتِي خُذْهَــــــــــــا","بِعَيْــــنِ القَلْــبِ لاَحِظْهَــا"],["وَاعْتَـــنِ حَتَّــــــــى تَحْفَظْهَــا","وَاذْكُـــرْ بِـهَــــا اسْمَ الله"],["كَلِمَةُ التَّـوْحِيـــــــــدِ مِنْهَــــــــا","لا إِلَهَ إِلّا اللـهْ"],["والَّــــذِي أُوصِـيك يَــــــا رَاوِي","عَلَيْـــكَ بِالبَدْرِ الضَّـــاوِي"],["شَيْخِـي أَحْمَــــــدُ العَـــلاَوِي","الـوَلــــيُّ غَــــــوْثُ الله"],["سِـــــــرُّهُ لِلْكُــــلِّ حَــــــــــاوِي","لا إِلَهَ إِلّا اللـهْ"],["لاَ تَجْعَـــلْ كَلاَمِـي هَــــــــزْلًا","لاَ تُؤَاخِـــذْ مِنِّــي فِعْـــلاً"],["رَبِّـي هَـبْ لِي قَـوْلاً فَصْـــــلًا","يهَتَــدِي الذي يَصْغَـــاهْ"],["وَثَبِّـتْ فِــي القُلُوبِ قَـــــــــوْلًا","لا إِلَهَ إِلّا اللـهْ"],["يَـــــا مُحَمَّـــدْ أنْــــــتَ دْوَايَ","يَا طَبِيبِــــــــي يَـــا مُنَــايَ"],["أَنْتَ شْفِيعِي أَنْتَ رْجَـــــــايَ","فَعَلَيْـــــــــــكَ صَلَّـــى اللهْ"],["كُلَّـــمَا قَـــــــالَ البَـــــرَايَــــــــــا","لا إِلَهَ إِلّا اللـهْ"],["يَــــا إلاَهِي حَقِّـقْ ظَنِّـــــــــــي","وَفِـــي حِصْنِــكْ أَدْخِلْنِي"],["ظَنِّي فِيـكَ تَعْفُــو عَنِّــــــــــــي","فِــــــي يَومٍ نَخْشَـى قَضَاهْ"],["عَبْــــــدُكَ المَدَانِـي فَنّـــــــــــي","لا إِلَهَ إِلّا اللـهْ"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":46,"printedNumber":10,"tocTitle":"أَهْـــلُ الله رَاهُــــمْ حَــــازُوا"},"n":10,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[{"note":"","src":"https://archive.org/download/zawiya-recordings/irshadiya-10.mp3","reciter":"","i":1}]}