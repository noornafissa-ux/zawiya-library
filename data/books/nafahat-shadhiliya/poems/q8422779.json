{"id":"q8422779","title":"يَا عَـرُوسَ الحَضـَرةْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["يَا عَـرُوسَ الحَـضْـرَة","يَا شَمْسَ الظُّهُورْ"],["يَا جَمِيلَ النَّـظْـرَة","يَا بَدْرَ البُدُورْ"],["جِئْتَ مِنَ الغَيْبِ","مِفْتَاحَ الـصُّدُورْ"],["ظَهَرْتَ بِلاَ عَيْبٍ","فِـي كُلِّ الأُمُورْ"],["بَهْجَـةَ المُحِـبِّ","نُــورٌ عَلَى نُــورْ"],["إِنَّ الْجَمَالَ يَسْبِي","عُقَيْلَ المَخْمُورْ"],["هَـذَا الكَوْنُ يُجْلَى","مِنْكَ يَا جَمِيلْ"],["وَالسُّطُورُ تُتْلَى","إِنَّكَ جَلِيلْ"],["وُجُـودُكْ تَجَلَّى","مَا لَهُ مَثِيلْ"],["بِالقُـدْسِ تَدَلَّى","بِالفَيْضِ الجَزيلْ"],["عَمَّ الخَلْقَ طُرًّا","سِـرُّكَ المَصُونْ"],["وَظَهَرْتَ جَهْراً","كَمْ لَكَ شُؤُونْ"],["لاَ تُعَدُّ حَصْـرًا","إِنَّهَا فُنُونْ"],["إِذْ رُفِعْتَ قَدْرًا","فَوْقَ كُلِّ الكَونْ"],["أَعْطَـاكَ الإِلَـهُ","خُلُقًا عَظِيمْ"],["فِيكَ قَالَ اللهُ","فِـي الذِّكْــرِ الحَـكِـــيمْ"],["كُـلُّ الخَلْقِ تَاهُوا","فِـي الفَيْـضِ العَـظِـيمْ"],["صَرَّحُوا وَفَاهُوا","إِلَيْكَ بِالتَّسْلِيمْ"],["رَحْمَةً لِلْخَلْقِ","جِئْتَ يَا رَسُولْ"],["آمِرًا بِالحَقِّ","وَالقَوْلِ المَنْزُولْ"],["إِنَّنِي بِالعِشْقِ","فِيكَ لَا أزُولْ"],["لَا أَرْضَـى بِالفَـرْقِ","إِنَّنِي المَوْصُولْ"],["امْنَحْنِي صِلاَتِي","يَا خَيْـرَ الوَرَى"],["عَلَيْكَ صَلاَتِي","دَائِمًا تُقْرَا"],["فِـي طُولِ حَيَاتِي","يَا زَيْنَ البُـشْـرَى"],["مَمْلُوكٌ سَادَتي","وَلَسْتُ حُرّا"]],"widths":[4241,4303],"gaps":[1083]}],"source":{"pdfPage":22,"printedNumber":12,"tocTitle":"يَا عَـرُوسَ الحَـضـرَة"},"n":12,"section":"muhammadiya","sectionTitle":"القصائد المحمدية","recordings":[{"note":"","src":"https://archive.org/download/zawiya-recordings/muhammadiya-12.mp3","reciter":"","i":1}]}