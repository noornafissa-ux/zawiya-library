{"id":"q8d2ec07","title":"دَارَتْ كُـؤوسُ الغَرَامْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["دَارَتْ كُؤُوسُ الغَرَامْ","مَا بَيْنَ المَوَالِي"],["فَزَادَتْهُمُ اصْطِلَامْ","حَالًا عَلَى حَالِ"],["قُلْتُ لَهُمْ يَا كِرَامْ","هَلْ تَرْضُوا بِحَالِي"],["فَقَالُوا لِي يَا غُلَامْ","إِذَا كُنْتَ خَالِي"],["فَقُلْتُ لَهُمْ نَعَمْ","قَوْلُكُمْ فِي بَالِي"],["وَلَكِنَّ يَا كِرَامْ","أَشْفِقُوا مِنْ حَالِي"],["إِنِّي كَثِيرُ الآلامْ","ضَعِيفُ الأَعْمَالِ"],["بِالنِّسْبَة لَكُمْ عَدَمْ","جَعَلْتُكُمْ فَالِي"],["ذِكْرُكُمْ لِيَ مُدَامْ","وَحُبُّكُمْ مَالِي"],["إِنَّ لِي فِيكُمْ هُيَامْ","لَيْتَهُ يَبْقَى لِي"],["فَيَا ضَيْعَةَ الأيَّامْ","فِي القِيلِ وَالقَالِ"],["لو كنتُ من أهلِ المَرَامْ","لَضَيّعت أشغالي"],["وهِمتُ بِكم هُيَامْ","والحــــقُّ يَصغى لي"],["في حُبِّكُم لا مَلامْ","واللومُ حَلا لي"],["فَإن كَانَ لي مَقَامْ","عندكمُ عالي"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":128,"printedNumber":36,"tocTitle":"دَارَتْ كُـؤوسُ الغَرَامْ"},"n":37,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}