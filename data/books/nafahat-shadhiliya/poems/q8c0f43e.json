{"id":"q8c0f43e","title":"لَقدْ مدَحتُ أيَـا إمَـامُ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["لَقَدْ مَدَحْتُ أَيَا إمامُ","ولَكِن كُلُّ المَديحِ فيكَ قَليلُ"],["وكمْ أَطَلتُ الكَلامَ وَلَكنْ","مَا لِبُلوغِ المَقَام سَبيلُ"],["إن النظامَ يَزينُ ولَكنْ","في مِثلِكَ لا يُفيدُ تَطويلُ"],["بِكلِّ التعبيرِ يضيق الضمير","فَهَذَا مَقَامٌ عَظِيمٌ جَليلُ"],["وماذا عَسَاني إذا قلتُ فيك","فكلُّ لِسَانٍ هُنَاكَ كَليلُ"],["ولكنَّ نَظمِي يَزْدَانُ إذا ما","أخذتُ في مَدْحِكَ قَلمي يَسيلُ"],["فيا رَبِّ أَبْقِ إمامَ البَرَايَا","فَأنتَ مُجيبٌ كريمٌ جَميلُ"]],"widths":[4270,4337],"gaps":[1016]}],"source":{"pdfPage":186,"printedNumber":null,"tocTitle":"لقد مدحتُ أيا إمامُ"},"n":null,"section":"unsectioned","sectionTitle":null,"recordings":[]}