{"id":"q741bae8","title":"عـرَّفْنيْ مَـحبُوبـي مَا لا نَدْرِيْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["عرَّفْني محبوبي ما لا ندري","في زمانٍ قَرِيبْ"],["كُلُّ عَاشِقْ يرى وُجودْ غيري","ليسَ له نصيبْ"],["أنا في كلّ حالةٍ نشـربْ","من مُدامٍ عتيقْ"],["وحبيبي بغِنائهِ يطربْ","مع صوتٍ رقيقْ"],["بألغازٍ وألحانٍ يسلَبْ","بقيّةَ العاشقْ"],["وأنا في ذاك الخطاب ندري","ولي فهمٌ صائبْ"],["كُلُّ عَاشِقْ يرى وُجودَ غيري","ليس لهُ نصيبْ"],["أنا من عِشقي ناداني الخمّار","بنداءٍ خفِيْ"],["بعد قُربي رفع عني الأستار","وتجلّى عَلَيْ"],["أين الغِنا قلتُ أين المزمارْ","لمّا بدا إليّ"],["قال لي إياك تُفشـي سـرِّي","ليس معي رقيب"],["كلُّ عَاشِقْ يرى وُجود غيري","ليس له نصيبْ"],["قلتُ من ذا الذي كان يَحْدِي","أطربَني الغِنا"],["إني سمعت أصوات الغَيْدِ","من وراء الحُسنا"],["قال إنّما أنا وحدي","ففهمتُ المعنى"],["قد دُهشتُ والله في أمري","هذا شيءٌ عجيبْ"],["كل عَاشِقْ يرى وجودْ غيري","ليسَ لهُ نصيبْ"],["أبْهَتَني واللهِ في القُرب","بعد فهمِ الكلامْ"],["لم ندرِ من أين كان شُـربي","حيّرَني الغرامْ"],["قد كان شُـربي من باطنِ قلبي","إنّنا نفسُ المُدامْ"],["قد صحّ صَحوي من بعد شُكري","وشفاني الطبيبْ"],["كل عَاشِقْ يرى وجود غيري","ليس له نصيبْ"],["يا حاديَ القوم باللهِ خَبّرْ","بكُنيَة العاشقْ"],["باسْمِه وألغازه ذكّرْ","ونَسْجِهْ الرّقيقْ"],["العَلَاوي يرجو الإله يستُر","من هفوةِ التّفريقْ"],["كيف يَفْرِقْني من هُوَ سـرّي","وروحي والقُلَيبْ"],["كل عَاشِقْ يرى وجود غيري","ليسَ له نَصيبْ"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":133,"printedNumber":42,"tocTitle":"عرَّفني مَحبُوبي مَا لا نَدري"},"n":43,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}