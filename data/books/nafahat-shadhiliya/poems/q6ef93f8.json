{"id":"q6ef93f8","title":"صَلّوا عَـلَى بَـدْرِ التَّـمَامْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":3,"rows":[["صَلُّوا عَـلَى بَـدْرِ التَّـمَامْ","شَمْسِ المَـعَـالِي","أَيُّهَا الْكِرَامْ"],["شَـفِيعُـنَا يَـوْمَ الـزِّحَـامْ","عِـنْدَ الأَهْـوَالِ","كَاشِفُ الغَمَامْ"],["مُـحَمَّـدٌ خَـيْـرُ الأَنَـامْ","مَـوْلَـى المَـوَالِـي","عَـلَـيْـهِ السَّــلاَمْ"],["نُـورُ اللَّـيَـالِـي وَالأَيَّـامْ","نُورُ الجَـمَـالِ","مِصْبَاحُ الظَّـلاَمْ"],["وَمَـنْ بِـهِ حُـزْنَـا ا لـمَـرَامْ","عِنْدَ المَآلِ","فِـي دَارِ السَّـلَامْ"],["يَـا رَحْـمَـةً بَـيْـنَ الأَنَـامْ","فِـي كُـلِّ حَـالِ","مَظْهَرُ الإِنْعَامْ"],["لَـوْلاَكَ يَــا زَيْـنَ اللِّثَامْ","لَــمَــا حَــلَا لِـي","مَـقْـصَـدٌ يُـــرَامْ"],["يَـا حِـصْـنَـنَا فَــلاَ نُـضَـامْ","وَلاَ نُـبَـالِي","لَوْمَةَ اللُّوَّامْ"],["شَوْقِي إلَيْكَ فِي ازْدِحَامْ","وَالوَجْـدُ حَــالِي","زَادَنِـي اضْطِرَامْ"]],"widths":[2834,2976,2679],"gaps":[567,567]}],"source":{"pdfPage":20,"printedNumber":9,"tocTitle":"صَلّوا عَـلَى بَـدرِ التَّـمَامْ"},"n":9,"section":"muhammadiya","sectionTitle":"القصائد المحمدية","recordings":[]}