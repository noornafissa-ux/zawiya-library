{"id":"q772abb5","title":"أَرّقَنِي الغَـرَامْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["أَرّقَنِي الغَرامْ","مِن حُسنِ ليلى"],["والقلبُ في هِيامْ","مَع الجَميلَا"],["ودَمعِي في انْسِجامْ","عَمِلتْ مَسِيلَا"],["مِنها صَابَتْني سِهامْ","صِـرتُ عَلِيلَا"],["لا قَصْدٌ يُرَامْ","وَلا لي مَيْلَا"],["ولا لَها في العَالمْ","مِثْلي مَثيلَا"],["قَالت يا غُلامْ","أَمْهِلْ قليلَا"],["وادنُ منّي باحتِرامْ","واشفِ الغَليلَا"],["فزِدتُ احْتِشَامْ","بِذَا المَقِيلَا"],["ولولا كَأسُ المُدَامْ","كَانَ وَسِيلَا"],["فَهِمتُ الكَلامْ","كُنتُ نَبِيلَا"],["بإشَارة وابتِسامْ","بِلا دَلِيلَا"],["صِرْنَا في اغْتِنامْ","ونَحنُ كُلَّا"],["بينَ صَحوٍ وَاصْطِلامْ","وقْتًا طَويلَا"],["تركتُ اللِّثَامْ","صَونَ الخَليلَا"],["خشْيَةَ اللِّئامْ","يدنو بِحِيلَا"],["عَليكِ السَّلامْ","قُلتُ يا ليلى"],["وعلى جَمعِ الكِرامْ","هُمُ الوَسيلَا"],["صلِّ يا سَلامْ","صَلاةً جَميلَا"],["على مِصباحِ الظَّلامْ","طَهَ الكَفِيلَا"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":118,"printedNumber":26,"tocTitle":"أَرّقَنِي الغَرامْ"},"n":27,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}