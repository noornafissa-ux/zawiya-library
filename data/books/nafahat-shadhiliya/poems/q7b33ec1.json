{"id":"q7b33ec1","title":"أزْعـَجتنيْ نَارُ هَـوَاكُمْ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["أزعَجَتني نَارُ هواكُمْ","واصْطِبَاري عَنكم طَالا"],["فارحموا مُغرَماً بكمْ","مَنْ قَلبُه تسجَّلَا"],["كَذا العقلُ طاشَ فِيكم","مُذ عَهَدتُم بالوصلا"],["بَلْ كشفتمُ غِطاكُمْ","ليتَ الوَصْلُ تكَمَلا"],["لا أبرحُ عَنْ بَابكُمْ","لَيتَ الوِدَّ تَعَجّلا"],["عِندِي ثِقةٌ بِفَضْلِكُمْ","لا تبخلُوا مَنْ سَألا"],["سَلا قَلْبِي عَن غَيرِكُمْ","وسناكُمْ فيه جَلا"],["فانفجرتْ عيني بِكُمْ","على الغُصنِ تجمَّلا"],["إن كان الغُصن بعضكمْ","كانَ بَعْضـي بكم كُلاً"],["ما ضـرَّهُ مَن نَجَاكمْ","قَولُهُ حَقًّا وَفَصْلا"],["إذ قَالَ بقولِكُمْ","أنتُمْ لَهُ فَرعٌ وَأصلا"],["كَمْ وقفتُ بِبَابكمْ","سَائلًا وَمُبتَهِلَا"],["أجيبُوني يرحمكُمْ","إنّي مُرتَجي مَا يُتلَى"],["كمْ رجوتُ طلعتَكم","مُتحيّراً وذاهِلا"],["كَمْ عَمِلتُ بِأمركِمْ","مُرتَجِيًا بِهِ وَصلَا"],["ارحَمُوني يرحمُكمْ","أجيبُوني بِلَا مَهلا"],["قَرِّبُوني بِفَضلِكُمْ","وإنْ كُنتُ لَستُ أهلا"],["صَرِّحوا لي بقولِكمْ","بَشِّـرُوني قُولُوا أهلا"],["لا أبرحُ عن بَابِكُمْ","في هواكُمْ دَمِي حَلَا"],["عذِّبوني في رِضَاكُمْ","غرِّبوني عَنِ الأَهلا"],["جَرّدِوني عَن سِوَاكمْ","أَلّفُوني وَحشَ الفلا"],["مَزِّقوني بغِنَاكُمْ","سمِّعوني صَوتاً يُحْلا"],["أجَابوني بِفضلِهم","من ضُلُوعٍ قَالُوا أَهلا"],["عَرَّفُوني بِنفسِهم","رَفعُوني إلى العُلا"],["مَزَجوني بحُبّهم","ذوَّقوني معنى الوصْلا"],["خَمَّرُوني بِشُـربِهم","في مَعناهم جُلْتُ جَوْلَا"],["غَيَّبوني في حُسنِهم","بَدَّلوني بهِم بَدلا"],["سمحوا لي بِذَاتهم","دَخَّلُوني بينَ الولا"],["كلّفُوني بـسرّهم","ملَّكوني كأسًا يُحلا"],["هَذَّبوني بِسيرهم","عَرَّفوني معنى القِبْلَا"],["إن سجدتُ نحوهم","وجدُتهم هُم الكُلّا"],["فَيا فَرحي بِهمْ","قَرَّبوا وزادوا وصلا"],["دام سـروري بهم","وأعرضتُ عن الخِلّا"],["حيثُ ضَاء سَناهُم","رَفعُوا عنّي الجهلا"],["إن قُلتُ فقولُهُمْ","لأنهم همُ الأصلا"],["حَياتي دَامت بِهمْ","مِن بَعدِ مَوتتي الأولى"],["قَرَّبوا لي ذاتهم","بلا وصلٍ ولا فصلا"],["إني لستُ سواهمْ","نبَّهوني مِن الغَفلا"],["صار الغينُ عينُهمْ","زال الغيمُ واضمحلا"],["لا وُجُودَ إلّا لهم","فَلا تُنكر هَذا القولا"],["فالخطابُ منهم لَهُمْ","والجوابُ منهم يُتلا"],["فلولا ذَلِكَ مِنهم","لَبقوا كَنزاً مُعطّلا"],["قَد ظَهرَ مَا كَان مِنهم","في البطُونِ وانجَلا"],["أظهروا الكونَ منهم","بلا شبهٍ ولا مِثلا"],["فالظهورُ منهم لهمْ","والبُطونُ فلا زالا"],["فَلا شيءَ سِوَاهُم","لا تَفصِيلاً لا إجمالا"],["فَلا تَركَت ذَاتَهُمْ","للسّوى قَدْرَ خَرْدَلا"],["عَبَدُوا أنفُسَهمْ","وَقَد صَلّوا بالحَمْدَلا"],["فالصّلاة منهم لهمْ","بتعظيمٍ وإجلالا"],["إني عُبيدُ عُبيدهمْ","مُعترِفٌ بَين المَلا"],["بالمُصطفى سألتُهُم","الهاشمي المُبَجَّلا"],["أن يُديموا لي قُربَهُمْ","ويؤيّدوا الوِصالا"],["ثم الصلاةُ بفضلهِمْ","على خاتمِ الرُسلا"],["محمدٌ خيرتهمْ","القائِمْ المُبتَهِلا"],["وآلهِ ومَن لهُمْ","قَدْ أقَرّ بالهيللا"],["وَصحبهِ ومَا لهُم","من أقطابٍ وَأبدالا"],["كذا الجزا برضاهُمْ","لشيخنا المُفَضّلا"],["العلاوي فاني فيهمْ","بن المُصطفى فخرُ العُلا"],["لأني الذي منهمْ","قَرَّبنا وأوصَلا"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":119,"printedNumber":27,"tocTitle":"أزعَجَتني نَارُ هواكُمْ"},"n":28,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}