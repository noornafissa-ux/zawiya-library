{"id":"q2b79aae","title":"أبْشِري يا نَفسُ اليَومَ بِالوِصَـالْ","author":"سيّدنا الشيخ محمد المدني","blocks":[{"cols":2,"rows":[["أبْشـِري يا نَفسُ اليَومَ بِالوصال","وارتَعي في رَوْضِ الأنْسٍ والقَبول"],["حَلَّتِ الأفراحُ والبُعدُ قَد زال","وظلامُ البَيْن كان في أُفولٍ"],["أشْرَقت شَمس مُحَيَّا ذا المفضال","شيخنا العلاويّ مِفتاح الدخول"],["لا مَلامَ إن عَربْدَ الخَيال","ثم قامَ صائِحًا وهو يَقول:"],["أبْشـِري يا نَفسُ اليَومَ بِالوصال","وارتَعي في رَوْضِ الأنْسِ والقَبول"],["لا جُناحَ على الـمُحبّ إن بَدا","قَمَرُ المحبوب زَالَت الشُّجون"],["هام وَجدًا في هواه وغَدَا","فَرطُ حُبِّه شُجُونٌ وجُنُون"],["إنَّ خَمْر الوَصل سُكْرُه حَلال","فَلِذا قُلتُ قولًا لا يَزول:"],["أبْشـِري يا نَفسُ اليَومَ بِالوصال","وارتَعي في رَوْضِ الأنْسِ والقَبول"],["أُضْرِمَتْ في كَبِدي نارُ الأشواق","ودُموع العَين زَادها الثَّجَج"],["نَبتَغي منكم سُوَيْعات التلاق","غيرَ أنَّ البُعد زادَني حَرج"],["أحمدُ الله الكَريمَ ذا الجَلال","وأنادي لمّا قَد نِلتُ الـمَأمول:"],["أبْشِـري يا نَفسُ اليَومَ بِالوصال","وارتَعي في رَوْضِ الأنْسِ والقَبول"],["كَم أنادي البَدْرَ في دُجَى الظلام","وأعاتِبُ الليالي والأيَّام"],["وأبيتُ سَاهِرًا أبْغي الـمَرام","وسَمير الشَّوق مَا لَه مَنام"],["أيَنامُ الليلَ مشغولُ الأحوال؟","إذ يُنادي دائمًا وهو يَقول:"],["أبْشـِري يا نَفسُ اليَومَ بِالوصال","وارتَعي في رَوْضِ الأنْسِ والقَبول"]],"widths":[4270,4337],"gaps":[1016]}],"source":{"pdfPage":100,"printedNumber":5,"tocTitle":"أبشِري يا نفسُ اليومَ بالوصَال"},"n":6,"section":"khamriya","sectionTitle":"القصائد الخمرية","recordings":[]}