{"id":"q9e92577","title":"يا مُـريدًا فُـزتَ بهِ","author":"سيّدنا الشيخ أحمد العلاوي","blocks":[{"cols":2,"rows":[["يــا مــريــدًا فُـزتَ بـهِ","بادِر واقصِدْ مَنْ تَهوَاه"],["إنْ أرَدتَ تَــفـنَـى فِـيـهِ","لا تَــصــغَ لِمَــا عَــدَاه"],["حـضّـِر قَـلبـكْ فـي اسـمـهِ","شـخِّصـهُ وافـهـم مـعـناه"],["وجّــه وجــهَــك لوجــهــهِ","واهـتـزَّ اشـتـيـاقـاً له"],["أخــفـِـضِ الطــرفَ لَدِيــهِ","وانـظُـر في ذاتكَ تراه"],["أيــنَ أنــتَ مـن حُـسـنـهِ","تاللهِ لســـتَ سِـــواه"],["إن قـيـلَ مَـن تـعني بهِ","صَـــرِّح وقُـــل هُــوَ الله"],["أنَـا فِـيـهِ فَـانـي بـهِ","يَـرانِــي كــمــا نــراه"],["لا نــرضــى بَــدلاً بِــهِ","أَهلُ الهَوى فِيهِ تَاهُوا"],["سُــكــارى حـيـارى فـيـهِ","صَــرَّحــوا بــهِ وفَاهُـوا"],["هُوَ قَصدِي لا نُخفيهِ","دَومـاً قَـلبي مَا يَنْسَاه"],["تـارةً يُـفـنِـيـنـي فـيـهِ","يَــظــهَـر عَـنّـي بِـسـَنـاهُ"],["تــارةً يُــبــقـيـنـي بـهِ","فـنـقـولُ أنـا لا هُـو"],["هُــوَ هُــوَ قصدي فــيــهِ","روحــي وذاتــي تَهــواه"],["الله الله نـعـنـي بـهِ","كــلُّ نــطــقــي بِــسَـنـاه"],["حِــبّــي حِـبّـي لا نُـريـهِ","نـخـشـى مـنهُ كي نلقاه"],["هُــوَ سِــرّي لا نُفـشـيـهِ","سِـوى لمـن يـدري مـا هُو"],["هُــوَ قــصــدي تُهــتُ بــهِ","غــيَّبــنــي عــمّـا سـواه"],["تــــكـــلّمـــتُ بـــأمـــرهِ","إن قــــــلتُ بــــــهِ وله"],["صــلَّيــتُ صـلاةً تُـرضـيـهِ","عــمَّن خـصّهُ واجـتـبـاه"],["والآلِ وأهــــلِ إرثــــهِ","ومـــن حَـــمــى لِحــمــاه"],["العَــلاوي فـانـي فـيـهِ","لا يَـرجُــو سِـوى رِضَـاه"],["مُـحـمّـدْ نـعـرِف مـا فيهِ","جــمــيـعُ الحُـسْـنِ حَـواه"],["يـــا ربِّ صـــلّ عـــلَيـــهِ","صــلاةً تَـشـمـل مَـعـنـاه"]],"widths":[4238,4305],"gaps":[1080]}],"source":{"pdfPage":81,"printedNumber":46,"tocTitle":"يا مريدًا فُزتَ بهِ"},"n":46,"section":"irshadiya","sectionTitle":"القصائد الإرشادية","recordings":[]}